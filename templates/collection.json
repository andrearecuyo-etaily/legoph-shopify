{
  "sections": {
    "banner": {
      "type": "brickline-page-banner",
      "settings": {
        "title_source": "collection",
        "title_size": "large",
        "background_color": "#ffd400",
        "text_color": "#000000",
        "show_breadcrumb": true,
        "breadcrumb_parent": "Sets by theme",
        "breadcrumb_parent_url": "/collections",
        "padding-block-start": 20,
        "padding-block-end": 20
      },
      "blocks": {
        "products": {
          "type": "button",
          "settings": {
            "label": "Products",
            "style": "dark"
          }
        },
        "about": {
          "type": "button",
          "settings": {
            "label": "About",
            "style": "light"
          }
        }
      },
      "block_order": [
        "products",
        "about"
      ]
    },
    "description": {
      "type": "brickline-collection-description",
      "settings": {
        "collapsible": true,
        "padding-block-start": 20,
        "padding-block-end": 20
      }
    },
    "grid": {
      "type": "brickline-collection-grid",
      "blocks": {
        "chip_new": {
          "type": "chip",
          "settings": {
            "tag": "New",
            "label": "New"
          }
        },
        "chip_exclusive": {
          "type": "chip",
          "settings": {
            "tag": "Exclusive",
            "label": "Exclusive"
          }
        },
        "chip_preorder": {
          "type": "chip",
          "settings": {
            "tag": "Pre-order",
            "label": "Pre-order"
          }
        }
      },
      "block_order": [
        "chip_new",
        "chip_exclusive",
        "chip_preorder"
      ],
      "settings": {
        "products_per_page": 16,
        "columns": 4,
        "show_sort": true,
        "show_filters": true,
        "show_back_to_top": true,
        "section_width": "page-width",
        "padding-block-start": 48,
        "padding-block-end": 0,
        "columns_tablet": 3,
        "columns_mobile": 2
      }
    },
    "gifts": {
      "type": "brickline-gift-banner",
      "blocks": {
        "offer_1": {
          "type": "offer",
          "settings": {
            "title": "Sea Serpent",
            "condition": "Spend over ₱9,000 to unlock this gift",
            "ends": "07/12/2026"
          }
        },
        "offer_2": {
          "type": "offer",
          "settings": {
            "title": "Airplane",
            "condition": "Spend over ₱5,000 on selected themes to unlock this gift",
            "ends": "07/12/2026"
          }
        }
      },
      "block_order": [
        "offer_1",
        "offer_2"
      ],
      "settings": {
        "heading": "Gifts with Purchase",
        "button_label": "Offer details",
        "background_color": "#00395d",
        "section_width": "page-width",
        "padding-block-start": 48,
        "padding-block-end": 56
      }
    }
  },
  "order": [
    "banner",
    "description",
    "grid",
    "gifts"
  ]
}
