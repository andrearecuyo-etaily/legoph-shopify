{% comment %}
  Filters drawer for the collection grid. Built from `collection.filters`, so the
  groups shown here are whatever the merchant configured in Search & Discovery.
  Submitting the form is a plain GET — no JS needed for the filtering itself.

  Accepts:
  - drawer_id: {String} required, matches the trigger's data-drawer-open
  - visible_count: {Number} options shown before "See more" (default 5)

  Usage:
  {% render 'brickline-filters-drawer', drawer_id: 'filters-123' %}
{% endcomment %}

{% liquid
  assign visible_count = visible_count | default: 5
%}

<brickline-drawer
  id="{{ drawer_id }}"
  class="bl-drawer"
  hidden
>
  <div
    class="bl-drawer__overlay"
    data-drawer-overlay
  ></div>

  <div
    class="bl-drawer__panel"
    data-drawer-panel
    role="dialog"
    aria-modal="true"
    aria-label="Filters"
  >
    <div class="bl-drawer__header">
      <span class="bl-drawer__title">Filters</span>
      <button
        type="button"
        class="bl-drawer__close"
        data-drawer-close
        aria-label="Close filters"
      >
        {%- render 'brickline-icon', icon: 'close' -%}
      </button>
    </div>

    <form
      method="get"
      class="bl-drawer__body"
    >
      {% comment %} Keep the active sort when filters are applied. {% endcomment %}
      {% if collection.sort_by != blank %}
        <input
          type="hidden"
          name="sort_by"
          value="{{ collection.sort_by }}"
        >
      {% endif %}

      {% for filter in collection.filters %}
        {% case filter.type %}
          {% when 'boolean' %}
            {% for value in filter.values %}
              <label class="bl-drawer__toggle">
                <input
                  type="checkbox"
                  name="{{ value.param_name }}"
                  value="{{ value.value }}"
                  {% if value.active %}
                    checked
                  {% endif %}
                >
                {{ filter.label }}
              </label>
            {% endfor %}

          {% when 'list' %}
            <div
              class="bl-drawer__group"
              data-filter-group
            >
              <div class="bl-drawer__group-header">
                <span class="bl-drawer__group-title">{{ filter.label }}</span>
              </div>
              <div class="bl-drawer__options">
                {% for value in filter.values %}
                  <label
                    class="bl-drawer__option{% if forloop.index > visible_count %} bl-drawer__option--overflow{% endif %}"
                  >
                    <input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      {% if value.active %}
                        checked
                      {% endif %}
                      {% if value.count == 0 and value.active == false %}
                        disabled
                      {% endif %}
                    >
                    <span>{{ value.label }} ({{ value.count }})</span>
                  </label>
                {% endfor %}
              </div>
              {% if filter.values.size > visible_count %}
                <button
                  type="button"
                  class="bl-drawer__more"
                  data-filter-more
                >
                  + See More
                </button>
              {% endif %}
            </div>

          {% when 'price_range' %}
            <div class="bl-drawer__group">
              <div class="bl-drawer__group-header">
                <span class="bl-drawer__group-title">{{ filter.label }}</span>
              </div>
              <div class="bl-drawer__range">
                <label>
                  <span class="visually-hidden">{{ filter.min_value.label }}</span>
                  <input
                    type="number"
                    name="{{ filter.min_value.param_name }}"
                    value="{{ filter.min_value.value | divided_by: 100 }}"
                    min="0"
                    max="{{ filter.range_max | divided_by: 100 }}"
                    placeholder="{{ 0 | money_without_currency }}"
                  >
                </label>
                <span aria-hidden="true">–</span>
                <label>
                  <span class="visually-hidden">{{ filter.max_value.label }}</span>
                  <input
                    type="number"
                    name="{{ filter.max_value.param_name }}"
                    value="{{ filter.max_value.value | divided_by: 100 }}"
                    min="0"
                    max="{{ filter.range_max | divided_by: 100 }}"
                    placeholder="{{ filter.range_max | money_without_currency }}"
                  >
                </label>
              </div>
            </div>
        {% endcase %}
      {% endfor %}

      <div class="bl-drawer__actions">
        <button
          type="submit"
          class="bl-drawer__apply"
        >
          Apply
        </button>
        <a
          href="{{ collection.url }}"
          class="bl-drawer__clear"
        >
          Clear all
        </a>
      </div>
    </form>
  </div>
</brickline-drawer>
