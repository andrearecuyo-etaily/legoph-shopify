{% comment %}
  Shared sidebar for the customer-account pages.

  Accepts:
  - current: {String} one of 'account', 'addresses', 'wishlist' — marks the active link

  Usage:
  {% render 'brickline-account-nav', current: 'account' %}
{% endcomment %}

<nav
  class="account__nav"
  aria-label="Account"
>
  <a
    href="{{ routes.account_url }}"
    class="account__nav-link{% if current == 'account' %} is-active{% endif %}"
    {% if current == 'account' %}
      aria-current="page"
    {% endif %}
  >
    My Orders
  </a>
  <a
    href="{{ routes.account_addresses_url }}"
    class="account__nav-link{% if current == 'addresses' %} is-active{% endif %}"
    {% if current == 'addresses' %}
      aria-current="page"
    {% endif %}
  >
    My Addresses
  </a>
  {% if settings.brickline_wishlist_url != blank %}
    <a
      href="{{ settings.brickline_wishlist_url }}"
      class="account__nav-link{% if current == 'wishlist' %} is-active{% endif %}"
      {% if current == 'wishlist' %}
        aria-current="page"
      {% endif %}
    >
      Wishlist
    </a>
  {% endif %}
  {% if customer %}
    <a
      href="{{ routes.account_logout_url }}"
      class="account__nav-link"
    >
      Log out
    </a>
  {% endif %}
</nav>
