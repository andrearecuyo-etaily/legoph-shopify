<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">

<div
  class="gift-banner brickline-section spacing-style section section--{{ section.settings.section_width }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div
    class="gift-banner__panel"
    style="--gift-bg: {{ section.settings.background_color }};"
  >
    <div class="gift-banner__intro">
      {% if section.settings.heading != blank %}
        <span class="gift-banner__heading">{{ section.settings.heading }}</span>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="gift-banner__button"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <ul class="gift-banner__offers">
        {% for block in section.blocks %}
          <li
            class="gift-banner__offer"
            {{ block.shopify_attributes }}
          >
            <span class="gift-banner__offer-title">{{ block.settings.title }}</span>
            {% if block.settings.condition != blank %}
              <span class="gift-banner__offer-condition">{{ block.settings.condition }}</span>
            {% endif %}
            {% if block.settings.ends != blank %}
              <span class="gift-banner__offer-ends">Ends {{ block.settings.ends }}</span>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .gift-banner__panel {
    background: var(--gift-bg, #00395d);
    color: var(--text-inverse, #ffffff);
    padding: 20px 24px;
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .gift-banner__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    min-width: 160px;
  }

  .gift-banner__heading {
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 800;
    font-size: 17px;
  }

  .gift-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-page, #ffffff);
    color: var(--brand-black, #000000);
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 12px;
    padding: 9px 18px;
    text-decoration: none;
    transition: filter 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .gift-banner__button:hover {
      filter: brightness(0.92);
    }
  }

  .gift-banner__offers {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  @media screen and (min-width: 750px) {
    .gift-banner__offers {
      gap: 40px;
    }
  }

  .gift-banner__offer {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .gift-banner__offer-title {
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 14px;
  }

  .gift-banner__offer-condition {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 12px;
    opacity: 0.85;
  }

  .gift-banner__offer-ends {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 11px;
    opacity: 0.7;
    margin-block-start: 4px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gift with purchase banner",
  "class": "section--gift-banner",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gifts with Purchase"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Offer details"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#00395d"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "Offer",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Gift name",
          "default": "Sea Serpent"
        },
        {
          "type": "text",
          "id": "condition",
          "label": "Condition",
          "default": "Spend over ₱9,000 to unlock this gift"
        },
        {
          "type": "text",
          "id": "ends",
          "label": "End date",
          "default": "07/12/2026"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift with purchase banner",
      "blocks": [
        { "type": "offer" },
        {
          "type": "offer",
          "settings": {
            "title": "Airplane",
            "condition": "Spend over ₱5,000 on selected themes to unlock this gift",
            "ends": "07/12/2026"
          }
        }
      ]
    }
  ]
}
{% endschema %}
