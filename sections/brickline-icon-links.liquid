<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">

<div
  class="icon-links brickline-section spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}; --icon-links-bg: {{ section.settings.background_color }}; --icon-links-fg: {{ section.settings.text_color }};"
>
  <div class="brickline-container icon-links__inner">
    {% for block in section.blocks %}
      <a
        href="{{ block.settings.link | default: '#' }}"
        class="icon-links__item"
        {{ block.shopify_attributes }}
      >
        <span class="icon-links__badge">
          {%- render 'brickline-icon', icon: block.settings.icon -%}
        </span>
        <span class="icon-links__label">{{ block.settings.label }}</span>
      </a>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .icon-links {
    background: var(--icon-links-bg, #006cb7);
    color: var(--icon-links-fg, #ffffff);
  }

  .icon-links__inner {
    display: flex;
    justify-content: center;
    gap: 40px;
    flex-wrap: wrap;
  }

  @media screen and (min-width: 750px) {
    .icon-links__inner {
      gap: 64px;
    }
  }

  .icon-links__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: inherit;
  }

  .icon-links__badge {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgb(255 255 255 / 15%);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .icon-links__item:hover .icon-links__badge {
      background: rgb(255 255 255 / 28%);
    }
  }

  .icon-links__badge svg {
    width: 20px;
    height: 20px;
  }

  .icon-links__label {
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 13px;
    text-align: center;
    max-width: 10ch;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Icon links band",
  "class": "section--icon-links",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#006cb7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "document", "label": "Document" },
            { "value": "question", "label": "Question" },
            { "value": "star", "label": "Star" },
            { "value": "gift", "label": "Gift" },
            { "value": "calendar", "label": "Calendar" }
          ],
          "default": "document"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Terms and Conditions"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon links band",
      "blocks": [
        { "type": "link", "settings": { "icon": "document", "label": "Terms and Conditions" } },
        { "type": "link", "settings": { "icon": "question", "label": "FAQs" } }
      ]
    }
  ]
}
{% endschema %}
