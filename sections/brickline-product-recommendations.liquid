{% liquid
  assign products_to_show = section.settings.products_to_show | default: 5
  assign source_collection = section.settings.collection

  # Prefer Shopify's recommendations; fall back to a merchant-picked collection so
  # the row still renders on products with no recommendation data yet.
  assign items = recommendations.products
  if items.size == 0 and source_collection != blank
    assign items = source_collection.products
  endif
%}

<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-product-card.css' | asset_url }}">

{% if recommendations.performed == false or items.size > 0 %}
  <div
    class="product-recs brickline-section spacing-style section section--{{ section.settings.section_width }}"
    style="{% render 'spacing-padding', settings: section.settings %}; --cols-mobile: {{ section.settings.columns_mobile }}; --cols-tablet: {{ section.settings.columns_tablet }}; --cols-desktop: {{ section.settings.columns }}; --brickline-card-radius: {{ settings.brickline_card_radius }}px;"
    data-recommendations-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ products_to_show }}"
  >
    {% if section.settings.heading != blank %}
      <h2 class="product-recs__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="product-recs__items brickline-grid">
      {% for recommended_product in items limit: products_to_show %}
        {% render 'brickline-product-card', product: recommended_product, show_meta: false, image_size: 500 %}
      {% endfor %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .product-recs__heading {
    margin: 0 0 20px;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 600;
    font-size: 24px;
  }

  @media screen and (min-width: 750px) {
    .product-recs__heading {
      font-size: 28px;
    }
  }

  .product-recs__items {
    gap: 20px;
  }
{% endstylesheet %}

<script
  src="{{ 'brickline-cart-actions.js' | asset_url }}"
  type="module"
></script>

{% schema %}
{
  "name": "Product recommendations",
  "class": "section--product-recs",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recommended For You"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns — desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns — tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns — mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Fallback collection",
      "info": "Used when Shopify has no recommendations for this product yet."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}
