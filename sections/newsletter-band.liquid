<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">

<div
  class="newsletter-band brickline-section spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme.id }}"
  style="
    {% render 'spacing-padding', settings: section.settings %};
    --newsletter-bg: {{ section.settings.color_scheme.settings.background }};
    --newsletter-text: {{ section.settings.color_scheme.settings.text }};
    --newsletter-button-bg: {{ section.settings.color_scheme.settings.button_background }};
    --newsletter-button-label: {{ section.settings.color_scheme.settings.button_label }};
  "
>
  <div class="newsletter-band__inner">
    <div class="newsletter-band__text">
      {% if section.settings.heading != blank %}
        <span class="newsletter-band__heading">{{ section.settings.heading }}</span>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <span class="newsletter-band__subheading">{{ section.settings.subheading }}</span>
      {% endif %}
    </div>

    {% form 'customer', class: 'newsletter-band__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {% if form.posted_successfully? %}
        <p class="newsletter-band__success">{{ 'blocks.email_signup.success' | t }}</p>
      {% else %}
        <label
          for="newsletter-band-email-{{ section.id }}"
          class="visually-hidden"
        >
          {{ 'blocks.email_signup.label' | t }}
        </label>
        <input
          type="email"
          name="contact[email]"
          id="newsletter-band-email-{{ section.id }}"
          class="newsletter-band__input"
          placeholder="{{ section.settings.placeholder | default: 'Your email address' }}"
          required
        >
        <button
          type="submit"
          class="newsletter-band__button"
        >
          {{ section.settings.button_label | default: 'Go' }}
        </button>
      {% endif %}
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .newsletter-band {
    background: var(--newsletter-bg);
    color: var(--newsletter-text);
    border-top: 1px solid var(--color-border-default, #d9d9d9);
    border-bottom: 1px solid var(--color-border-default, #d9d9d9);
    margin-top: 40px;
  }

  .newsletter-band__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .newsletter-band__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .newsletter-band__heading {
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .newsletter-band__subheading {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 13px;
    opacity: 0.75;
  }

  .newsletter-band__form {
    display: flex;
    gap: 12px;
    width: 100%;
    max-width: 395px;
  }

  .newsletter-band__input {
    flex: 1;
    min-width: 0;
    background: var(--newsletter-bg);
    border: 1px solid var(--color-border-default, #d9d9d9);
    border-radius: 999px;
    padding: 12px 20px;
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 14px;
    color: var(--newsletter-text);
  }

  .newsletter-band__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: none;
    background: var(--newsletter-button-bg);
    color: var(--newsletter-button-label);
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 14px;
    padding: 12px 28px;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 150ms ease;
  }

  .newsletter-band__button:active {
    transform: scale(0.97);
  }

  .newsletter-band__success {
    margin: 0;
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 14px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter band",
  "class": "section--newsletter-band",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe to Brickline Certified Store"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Be the first to hear about new sets, exclusive products and promotions."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Your email address here"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Go"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-white"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Newsletter band"
    }
  ]
}
{% endschema %}
