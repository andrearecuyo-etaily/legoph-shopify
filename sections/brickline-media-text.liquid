<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">

<div
  class="media-text brickline-section spacing-style section section--{{ section.settings.section_width }} media-text--media-{{ section.settings.media_position }} media-text--mobile-{{ section.settings.mobile_order }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --media-text-ratio: {{ section.settings.image_ratio }};"
>
  <div class="media-text__grid">
    <div class="media-text__media">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.image.alt | escape }}"
          class="media-text__image"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'media-text__placeholder' }}
      {% endif %}
    </div>

    <div class="media-text__content">
      {% if section.settings.heading != blank %}
        <h2 class="media-text__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="media-text__body">{{ section.settings.body }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="media-text__button"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .media-text__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: center;
  }

  /* Stacked below 750px, so `mobile_order` — not the desktop left/right
     choice — decides which cell reads first. */
  .media-text--mobile-text .media-text__media {
    order: 1;
  }

  @media screen and (min-width: 750px) {
    .media-text__grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }

    .media-text--media-start .media-text__media,
    .media-text--mobile-text .media-text__media {
      order: 0;
    }

    .media-text--media-end .media-text__media {
      order: 1;
    }
  }

  .media-text__media {
    background: var(--surface-secondary, #fafafa);
    aspect-ratio: var(--media-text-ratio, 16 / 9);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .media-text__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-text__placeholder {
    width: 100%;
    height: 100%;
    fill: var(--surface-strong-neutral, #d9d9d9);
  }

  .media-text__content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .media-text__heading {
    margin: 0;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 24px;
    line-height: 1.25;
  }

  @media screen and (min-width: 750px) {
    .media-text__heading {
      font-size: 28px;
    }
  }

  .media-text__body {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 15px;
    color: var(--text-subtle, #636363);
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .media-text__body p {
    margin: 0;
  }

  .media-text__button {
    align-self: flex-start;
    background: var(--brand-black, #000000);
    color: var(--text-inverse, #ffffff);
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 13px;
    padding: 14px 28px;
    text-decoration: none;
    transition: filter 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .media-text__button:hover {
      filter: brightness(1.4);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Media with text",
  "class": "section--media-text",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What is Brickline Rewards Loyalty Program?"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Free to join with no tiers or limits, Brickline Rewards is a loyalty program where you earn points on each purchase when shopping with us.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media position — desktop",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "end", "label": "Right" }
      ],
      "default": "end"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "Mobile order",
      "info": "Which cell comes first once the two stack below 750px.",
      "options": [
        { "value": "media", "label": "Image first" },
        { "value": "text", "label": "Text first" }
      ],
      "default": "media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "16 / 9", "label": "16:9" },
        { "value": "4 / 3", "label": "4:3" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "3 / 4", "label": "Portrait" }
      ],
      "default": "16 / 9"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Media with text"
    }
  ]
}
{% endschema %}
