<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">

<div
  class="feature-band feature-band--{{ section.settings.layout }} feature-band--mobile-{{ section.settings.mobile_order }} brickline-section spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}; --band-bg: {{ section.settings.background_color }}; --band-fg: {{ section.settings.text_color }}; --band-ratio: {{ section.settings.image_ratio }};"
>
  <div class="brickline-container feature-band__inner">
    <div class="feature-band__media">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 1400 }}"
          alt="{{ section.settings.image.alt | escape }}"
          class="feature-band__image"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      {% endif %}
    </div>

    <div class="feature-band__content">
      {% if section.settings.eyebrow != blank %}
        <span class="feature-band__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="feature-band__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="feature-band__body">{{ section.settings.body }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="feature-band__button"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .feature-band {
    background: var(--band-bg, #00395d);
    color: var(--band-fg, #ffffff);
  }

  .feature-band__media {
    background: var(--surface-secondary, #fafafa);
    aspect-ratio: var(--band-ratio, 16 / 10);
    overflow: hidden;
  }

  .feature-band__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature-band__content {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .feature-band__eyebrow {
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0.7;
  }

  .feature-band__heading {
    margin: 0;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 800;
    font-size: 22px;
    line-height: 1.2;
    color: inherit;
  }

  @media screen and (min-width: 750px) {
    .feature-band__heading {
      font-size: 26px;
    }
  }

  .feature-band__body {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 14px;
    opacity: 0.85;
    line-height: 1.6;
  }

  .feature-band__body p {
    margin: 0 0 10px;
  }

  .feature-band__body > :last-child {
    margin-block-end: 0;
  }

  .feature-band__button {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-page, #ffffff);
    color: var(--brand-black, #000000);
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 13px;
    padding: 12px 24px;
    text-decoration: none;
    transition: filter 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .feature-band__button:hover {
      filter: brightness(0.92);
    }
  }

  /* Stacked: centered image over centered copy. */
  .feature-band--stacked .feature-band__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .feature-band--stacked .feature-band__media {
    width: 100%;
    max-width: 700px;
  }

  .feature-band--stacked .feature-band__content {
    align-items: center;
    text-align: center;
    max-width: 560px;
  }

  .feature-band--stacked .feature-band__button {
    align-self: center;
  }

  /* Split: image and copy side by side. */
  .feature-band--media-start .feature-band__inner,
  .feature-band--media-end .feature-band__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: center;
  }

  /* Below the tablet breakpoint the two cells stack, so the desktop
     left/right choice no longer decides what a reader sees first —
     `mobile_order` does. */
  .feature-band--mobile-text .feature-band__media {
    order: 1;
  }

  @media screen and (min-width: 750px) {
    .feature-band--media-start .feature-band__inner,
    .feature-band--media-end .feature-band__inner {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }

    .feature-band--media-start .feature-band__media,
    .feature-band--mobile-text .feature-band__media {
      order: 0;
    }

    .feature-band--media-end .feature-band__media {
      order: 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Feature band",
  "class": "section--feature-band",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "stacked", "label": "Image above centered text" },
        { "value": "media-start", "label": "Image left, text right" },
        { "value": "media-end", "label": "Text left, image right" }
      ],
      "default": "stacked"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "Mobile order",
      "info": "Which cell comes first once the two stack below 750px.",
      "options": [
        { "value": "media", "label": "Image first" },
        { "value": "text", "label": "Text first" }
      ],
      "default": "media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "16 / 10", "label": "16:10" },
        { "value": "16 / 9", "label": "16:9" },
        { "value": "4 / 3", "label": "4:3" },
        { "value": "1 / 1", "label": "Square" }
      ],
      "default": "16 / 10"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bursting with blooms — and room to grow"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#00395d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Feature band"
    }
  ]
}
{% endschema %}
