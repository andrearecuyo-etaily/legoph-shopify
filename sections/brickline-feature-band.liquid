{% comment %}
  Content can come from the product instead of the section, so several products
  can share one product template without sharing its copy. Section settings in a
  template JSON belong to the template, not the product.

  "Band position" picks one entry from the product's `custom.story_bands` list;
  0 keeps the section's own settings. Layout, ratio and padding always stay
  section settings — those belong to the template's design, not the product.

  Anything the metaobject leaves empty falls back to the section setting, so a
  product can override only its heading and inherit the rest.
{% endcomment %}

{% liquid
  assign band = blank
  assign position = section.settings.product_band_position

  if position > 0 and product != blank
    assign bands = product.metafields.custom.story_bands.value
    if bands != blank
      assign band = bands[position | minus: 1]
    endif
  endif

  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign body = section.settings.body
  assign image = section.settings.image
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign band_bg = section.settings.background_color
  assign band_fg = section.settings.text_color

  if band != blank
    if band.eyebrow.value != blank
      assign eyebrow = band.eyebrow.value
    endif
    if band.heading.value != blank
      assign heading = band.heading.value
    endif
    if band.body != blank
      assign body = band.body
    endif
    if band.image.value != blank
      assign image = band.image.value
      # A file_reference resolves to a media_image, but image_picker gives a
      # plain image. Unwrap so image_url / alt / width / height work on either.
      if image.image != blank
        assign image = image.image
      endif
    endif
    if band.button_label.value != blank
      assign button_label = band.button_label.value
    endif
    if band.button_link.value != blank
      assign button_link = band.button_link.value
    endif
    if band.background_color.value != blank
      assign band_bg = band.background_color.value
    endif
    if band.text_color.value != blank
      assign band_fg = band.text_color.value
    endif
  endif

  # Last resort: borrow from the product gallery so an unfilled band shows a
  # picture rather than an empty box. Band 1 takes the second image, band 2 the
  # third, and so on, so two bands never show the same shot. Off by default —
  # bands usually want lifestyle imagery, not a repeat of the gallery.
  if image == blank and section.settings.fallback_to_product_media and position > 0
    # product.media gives a media object; preview_image is the plain image, so
    # image_url / alt / width / height match the other two sources.
    assign fallback = product.media[position].preview_image
    if fallback != blank
      assign image = fallback
    endif
  endif
%}

<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">

<div
  class="feature-band feature-band--{{ section.settings.layout }} feature-band--mobile-{{ section.settings.mobile_order }} feature-band--text-{{ section.settings.text_alignment }} brickline-section spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}; --band-bg: {{ band_bg }}; --band-fg: {{ band_fg }}; --band-ratio: {{ section.settings.image_ratio }};"
>
  <div class="brickline-container feature-band__inner">
    <div class="feature-band__media">
      {% if image != blank %}
        <img
          src="{{ image | image_url: width: 1400 }}"
          alt="{{ image.alt | escape }}"
          class="feature-band__image"
          width="{{ image.width }}"
          height="{{ image.height }}"
          loading="lazy"
        >
      {% endif %}
    </div>

    <div class="feature-band__content">
      {% if eyebrow != blank %}
        <span class="feature-band__eyebrow">{{ eyebrow }}</span>
      {% endif %}
      {% if heading != blank %}
        <h2 class="feature-band__heading">{{ heading }}</h2>
      {% endif %}
      {% if body != blank %}
        <div class="feature-band__body">{{ body }}</div>
      {% endif %}
      {% if button_label != blank %}
        <a
          href="{{ button_link | default: '#' }}"
          class="feature-band__button"
        >
          {{ button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .feature-band {
    background: var(--band-bg, #00395d);
    color: var(--band-fg, #ffffff);
  }

  .feature-band__media {
    background: var(--surface-secondary, #fafafa);
    aspect-ratio: var(--band-ratio, 16 / 10);
    overflow: hidden;
  }

  .feature-band__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature-band__content {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .feature-band--text-start .feature-band__content {
    align-items: flex-start;
    text-align: start;
  }

  .feature-band--text-end .feature-band__content {
    align-items: flex-end;
    text-align: end;
  }

  .feature-band--text-center .feature-band__content {
    align-items: center;
    text-align: center;
  }

  .feature-band--text-end .feature-band__button,
  .feature-band--text-center .feature-band__button {
    align-self: auto;
  }

  .feature-band__eyebrow {
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0.7;
  }

  .feature-band__heading {
    margin: 0;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 800;
    font-size: 22px;
    line-height: 1.2;
    color: inherit;
  }

  @media screen and (min-width: 750px) {
    .feature-band__heading {
      font-size: 26px;
    }
  }

  .feature-band__body {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 14px;
    opacity: 0.85;
    line-height: 1.6;
  }

  .feature-band__body p {
    margin: 0 0 10px;
  }

  .feature-band__body > :last-child {
    margin-block-end: 0;
  }

  .feature-band__button {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-page, #ffffff);
    color: var(--brand-black, #000000);
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 13px;
    padding: 12px 24px;
    text-decoration: none;
    transition: filter 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .feature-band__button:hover {
      filter: brightness(0.92);
    }
  }

  /* Stacked: centered image over centered copy. */
  .feature-band--stacked .feature-band__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .feature-band--stacked .feature-band__media {
    width: 100%;
    max-width: 700px;
  }

  .feature-band--stacked .feature-band__content {
    align-items: center;
    text-align: center;
    max-width: 560px;
  }

  .feature-band--stacked .feature-band__button {
    align-self: center;
  }

  /* Split: image and copy side by side. */
  .feature-band--media-start .feature-band__inner,
  .feature-band--media-end .feature-band__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: center;
  }

  /* Below the tablet breakpoint the two cells stack, so the desktop
     left/right choice no longer decides what a reader sees first —
     `mobile_order` does. */
  .feature-band--mobile-text .feature-band__media {
    order: 1;
  }

  @media screen and (min-width: 750px) {
    .feature-band--media-start .feature-band__inner,
    .feature-band--media-end .feature-band__inner {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }

    .feature-band--media-start .feature-band__media,
    .feature-band--mobile-text .feature-band__media {
      order: 0;
    }

    .feature-band--media-end .feature-band__media {
      order: 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Feature band",
  "class": "section--feature-band",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "On a product template, set Band position to pull this band's copy from the product's Story bands metafield instead of the settings below. Empty metaobject fields fall back to these settings."
    },
    {
      "type": "range",
      "id": "product_band_position",
      "label": "Band position (product templates)",
      "info": "0 = use the settings below. 1 = the product's first story band, 2 the second, and so on.",
      "min": 0,
      "max": 6,
      "step": 1,
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "fallback_to_product_media",
      "label": "Fall back to the product's gallery",
      "info": "When the story band has no image, borrow one from the product's photos instead of leaving an empty box. Band 1 takes the second photo, band 2 the third.",
      "default": false
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "stacked", "label": "Image above centered text" },
        { "value": "media-start", "label": "Image left, text right" },
        { "value": "media-end", "label": "Text left, image right" }
      ],
      "default": "stacked"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Centered" },
        { "value": "end", "label": "Right" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "Mobile order",
      "info": "Which cell comes first once the two stack below 750px.",
      "options": [
        { "value": "media", "label": "Image first" },
        { "value": "text", "label": "Text first" }
      ],
      "default": "media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "16 / 10", "label": "16:10" },
        { "value": "16 / 9", "label": "16:9" },
        { "value": "4 / 3", "label": "4:3" },
        { "value": "1 / 1", "label": "Square" }
      ],
      "default": "16 / 10"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bursting with blooms — and room to grow"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#00395d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Feature band"
    }
  ]
}
{% endschema %}
