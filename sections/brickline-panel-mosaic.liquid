{% liquid
  # The first block is the tall feature panel on the left; the rest stack down the
  # right-hand column, so the feature has to span exactly as many rows as they fill.
  assign stacked_count = section.blocks.size | minus: 1
  if stacked_count < 1
    assign stacked_count = 1
  endif
%}

<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">

<div
  class="panel-mosaic brickline-section spacing-style section section--{{ section.settings.section_width }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --mosaic-rows: {{ stacked_count }};"
>
  {% if section.settings.heading != blank %}
    <h2 class="panel-mosaic__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="panel-mosaic__grid">
    {% for block in section.blocks %}
      {% liquid
        assign is_feature = false
        if forloop.first
          assign is_feature = true
        endif
      %}
      <div
        class="panel-mosaic__panel{% if is_feature %} panel-mosaic__panel--feature{% endif %}"
        style="--panel-bg: {{ block.settings.background_color }};"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.title != blank %}
          <h3 class="panel-mosaic__title">{{ block.settings.title }}</h3>
        {% endif %}
        {% if block.settings.body != blank %}
          <p class="panel-mosaic__body">{{ block.settings.body }}</p>
        {% endif %}

        {% if is_feature %}
          <div class="panel-mosaic__media">
            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | image_url: width: 900 }}"
                alt="{{ block.settings.image.alt | escape }}"
                class="panel-mosaic__image"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.link_label != blank %}
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="panel-mosaic__link"
          >
            {{ block.settings.link_label }} &rsaquo;
          </a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .panel-mosaic__heading {
    margin: 0 0 24px;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 22px;
  }

  @media screen and (min-width: 750px) {
    .panel-mosaic__heading {
      font-size: 24px;
    }
  }

  .panel-mosaic__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4px;
  }

  @media screen and (min-width: 750px) {
    .panel-mosaic__grid {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 1fr;
    }

    .panel-mosaic__panel--feature {
      grid-column: 1;
      grid-row: 1 / span var(--mosaic-rows, 2);
    }
  }

  .panel-mosaic__panel {
    background: var(--panel-bg, #00395d);
    color: var(--text-inverse, #ffffff);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .panel-mosaic__panel--feature {
    padding: 32px;
    gap: 12px;
    min-height: 320px;
  }

  .panel-mosaic__title {
    margin: 0;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 16px;
    color: var(--text-inverse, #ffffff);
  }

  .panel-mosaic__panel--feature .panel-mosaic__title {
    font-size: 18px;
  }

  .panel-mosaic__body {
    margin: 0;
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 13px;
    color: rgb(255 255 255 / 85%);
    line-height: 1.6;
  }

  .panel-mosaic__media {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-block-start: 12px;
    background: rgb(255 255 255 / 10%);
    min-height: 120px;
    overflow: hidden;
  }

  .panel-mosaic__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .panel-mosaic__link {
    margin-block-start: auto;
    align-self: flex-start;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 13px;
    color: var(--text-inverse, #ffffff);
    text-decoration: none;
    border-bottom: 2px solid currentcolor;
    padding-block-end: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Panel mosaic",
  "class": "section--panel-mosaic",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About Rewards Centre"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        {
          "type": "paragraph",
          "content": "The first panel is the tall one on the left and is the only one that shows an image."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Get the Rewards You Really (Really) Want"
        },
        {
          "type": "text",
          "id": "body",
          "label": "Body",
          "default": "From unique digital unlocks to exclusive items."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (first panel only)"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background",
          "default": "#00395d"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Panel mosaic",
      "blocks": [
        {
          "type": "panel",
          "settings": {
            "title": "Get the Rewards You Really (Really) Want",
            "body": "From unique digital unlocks to exclusive items.",
            "background_color": "#00395d"
          }
        },
        {
          "type": "panel",
          "settings": {
            "title": "Redeem your Rewards",
            "body": "Once you're in, the only hard part is picking your reward.",
            "background_color": "#006cb7"
          }
        },
        {
          "type": "panel",
          "settings": {
            "title": "See Your Points In One Place",
            "body": "The Rewards Centre is where you can check your points balance and history.",
            "background_color": "#00395d"
          }
        }
      ]
    }
  ]
}
{% endschema %}
