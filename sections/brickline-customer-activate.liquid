{% comment %}
  Account activation form Shopify links to from the invite email. Classic customer accounts only.
{% endcomment %}

<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-account.css' | asset_url }}">

<div
  class="customer-auth brickline-section spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="customer-auth__inner">
    <h1 class="customer-auth__heading">{{ section.settings.heading | default: 'Activate your account' }}</h1>
    {% if section.settings.subheading != blank %}
      <p class="customer-auth__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="customer-auth__card">
      <div class="customer-auth__panel is-active">
        {% form 'activate_customer_password', novalidate: 'novalidate' %}
          {% if form.errors %}
            <div
              class="customer-auth__errors"
              role="alert"
            >
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <label for="new-password-{{ section.id }}">New password</label>
          <input
            id="new-password-{{ section.id }}"
            type="password"
            name="customer[password]"
            autocomplete="new-password"
            required
          >

          <label for="confirm-password-{{ section.id }}">Confirm password</label>
          <input
            id="confirm-password-{{ section.id }}"
            type="password"
            name="customer[password_confirmation]"
            autocomplete="new-password"
            required
          >

          <button
            type="submit"
            class="customer-auth__submit"
          >
            {{ section.settings.submit_label | default: 'Activate account' }}
          </button>

          <button
            type="submit"
            name="decline"
            class="customer-auth__link customer-auth__link--center"
          >
            Decline invitation
          </button>
        {% endform %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer activate account",
  "class": "section--customer-auth",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Activate your account"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit label",
      "default": "Activate account"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
