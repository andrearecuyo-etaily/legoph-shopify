<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">

<div
  class="cta-banner brickline-section spacing-style section section--{{ section.settings.section_width }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div
    class="cta-banner__panel"
    style="--cta-bg: {{ section.settings.background_color }}; --cta-fg: {{ section.settings.text_color }};"
  >
    <div class="cta-banner__text">
      {% if section.settings.heading != blank %}
        <span class="cta-banner__heading">{{ section.settings.heading }}</span>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <span class="cta-banner__subheading">{{ section.settings.subheading }}</span>
      {% endif %}
    </div>

    {% if section.settings.button_label != blank %}
      <a
        href="{{ section.settings.button_link | default: '#' }}"
        class="cta-banner__button"
      >
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .cta-banner__panel {
    background: var(--cta-bg, #00af4d);
    color: var(--cta-fg, #ffffff);
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .cta-banner__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cta-banner__heading {
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 800;
    font-size: 17px;
  }

  @media screen and (min-width: 750px) {
    .cta-banner__heading {
      font-size: 18px;
    }
  }

  .cta-banner__subheading {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 13px;
    opacity: 0.85;
  }

  .cta-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-page, #ffffff);
    color: var(--brand-black, #000000);
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 13px;
    padding: 12px 24px;
    text-decoration: none;
    transition: filter 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .cta-banner__button:hover {
      filter: brightness(0.92);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CTA banner",
  "class": "section--cta-banner",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Celebrate Insiders Days with double loyalty points"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "7/7–7/12, while supplies last.*"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#00af4d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "CTA banner"
    }
  ]
}
{% endschema %}
