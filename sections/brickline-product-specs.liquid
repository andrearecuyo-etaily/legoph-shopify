{% liquid
  assign body = section.settings.body
  if body == blank
    assign body = product.description
  endif
  assign bullets = section.blocks | where: 'type', 'bullet'
  assign tags = section.blocks | where: 'type', 'tag'
%}

<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">

<div
  class="product-specs brickline-section spacing-style section section--{{ section.settings.section_width }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <h2 class="product-specs__heading">{{ section.settings.heading | default: 'Specifications' }}</h2>

  <div class="product-specs__layout">
    <div class="product-specs__copy">
      {% if body != blank %}
        <div class="product-specs__body">{{ body }}</div>
      {% endif %}

      {% if bullets.size > 0 %}
        <ul class="product-specs__bullets">
          {% for bullet in bullets %}
            <li {{ bullet.shopify_attributes }}>{{ bullet.settings.text }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    <div class="product-specs__media">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 900 }}"
          alt="{{ section.settings.image.alt | escape }}"
          class="product-specs__image"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      {% elsif product.media.size > 1 %}
        {% assign secondary = product.media[1] %}
        <img
          src="{{ secondary | image_url: width: 900 }}"
          alt="{{ secondary.alt | default: product.title | escape }}"
          class="product-specs__image"
          width="{{ secondary.preview_image.width }}"
          height="{{ secondary.preview_image.height }}"
          loading="lazy"
        >
      {% endif %}
    </div>
  </div>

  {% if tags.size > 0 %}
    <div class="product-specs__tags">
      <span class="product-specs__tags-label">{{ section.settings.tags_label | default: 'Shop more like this:' }}</span>
      {% for tag in tags %}
        <a
          href="{{ tag.settings.link | default: '#' }}"
          class="product-specs__tag"
          {{ tag.shopify_attributes }}
        >
          {{ tag.settings.label }}
        </a>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .product-specs__heading {
    margin: 0 0 20px;
    padding-block-end: 14px;
    border-bottom: 1px solid var(--color-border-default, #d9d9d9);
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 600;
    font-size: 24px;
  }

  @media screen and (min-width: 750px) {
    .product-specs__heading {
      font-size: 28px;
    }
  }

  .product-specs__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }

  @media screen and (min-width: 750px) {
    .product-specs__layout {
      grid-template-columns: 1.6fr 1fr;
      gap: 40px;
    }
  }

  .product-specs__copy {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 14px;
    color: var(--text-subtle, #636363);
    line-height: 1.7;
  }

  .product-specs__body p {
    margin: 0 0 16px;
  }

  .product-specs__bullets {
    margin: 0;
    padding-inline-start: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .product-specs__media {
    background: var(--surface-secondary, #fafafa);
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .product-specs__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-specs__tags {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    margin-block-start: 28px;
    padding-block-start: 20px;
    border-top: 1px solid var(--color-border-default, #d9d9d9);
  }

  .product-specs__tags-label {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 13px;
    color: var(--text-subtle, #636363);
  }

  .product-specs__tag {
    display: inline-flex;
    align-items: center;
    padding: 7px 14px;
    border: 1px solid var(--color-border-default, #d9d9d9);
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 12px;
    color: var(--text-default, #141414);
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-specs__tag:hover {
      border-color: var(--brand-black, #000000);
      background: var(--surface-tertiary, #f7f7f7);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product specifications",
  "class": "section--product-specs",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Specifications"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Intro",
      "info": "Defaults to the product description."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Defaults to the product's second image."
    },
    {
      "type": "text",
      "id": "tags_label",
      "label": "Tag row label",
      "default": "Shop more like this:"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "REALISTIC FEATURES — Try out authentic details as you build"
        }
      ]
    },
    {
      "type": "tag",
      "name": "Tag",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Technic"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product specifications"
    }
  ]
}
{% endschema %}
