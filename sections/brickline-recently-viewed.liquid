{% comment %}
  Renders in two contexts:
  1. On the product page it outputs an empty, hidden shell.
  2. Fetched again through the Section Rendering API against the search route
     (`/search?q=id:1 OR id:2&section_id=…`) it renders the actual cards, which
     brickline-product-extras.js moves into the shell. Horizon already writes the
     viewed-product ids to localStorage from snippets/scripts.liquid.
{% endcomment %}

{% liquid
  assign products_to_show = section.settings.products_to_show | default: 5
%}

<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-product-card.css' | asset_url }}">

<div
  class="recently-viewed brickline-section spacing-style section section--{{ section.settings.section_width }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --cols-mobile: {{ section.settings.columns_mobile }}; --cols-tablet: {{ section.settings.columns_tablet }}; --cols-desktop: {{ section.settings.columns }}; --brickline-card-radius: {{ settings.brickline_card_radius }}px;"
  data-recently-viewed-section="{{ section.id }}"
  data-current-product-id="{{ product.id }}"
  {% if search.results.size == 0 %}
    hidden
  {% endif %}
>
  {% if section.settings.heading != blank %}
    <h2 class="recently-viewed__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="recently-viewed__items brickline-grid">
    {% for result in search.results limit: products_to_show %}
      {% if result.object_type == 'product' %}
        {% render 'brickline-product-card', product: result, show_meta: false, image_size: 500 %}
      {% endif %}
    {% endfor %}
  </div>
</div>

<script
  src="{{ 'brickline-product-extras.js' | asset_url }}"
  type="module"
></script>
<script
  src="{{ 'brickline-cart-actions.js' | asset_url }}"
  type="module"
></script>

{% stylesheet %}
  .recently-viewed[hidden] {
    display: none;
  }

  .recently-viewed__heading {
    margin: 0 0 20px;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 600;
    font-size: 24px;
  }

  @media screen and (min-width: 750px) {
    .recently-viewed__heading {
      font-size: 28px;
    }
  }

  .recently-viewed__items {
    gap: 20px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Recently viewed",
  "class": "section--recently-viewed",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently Viewed"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns — desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns — tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns — mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Recently viewed"
    }
  ]
}
{% endschema %}
