<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">

{% liquid
  assign menu = linklists[section.settings.menu]
%}

<brickline-header-component
  class="brickline-header brickline-section spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme.id }}"
  style="
    {% render 'spacing-padding', settings: section.settings %};
    --header-bg: {{ section.settings.color_scheme.settings.background }};
    --header-text: {{ section.settings.color_scheme.settings.text }};
  "
>
  <div class="brickline-header__inner brickline-container">
    {% if menu %}
      <button
        type="button"
        class="brickline-header__menu-toggle"
        aria-expanded="false"
        aria-controls="brickline-header-menu-{{ section.id }}"
        aria-label="Menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    {% endif %}

    {% if settings.logo %}
      <a href="{{ routes.root_url }}" class="brickline-header__logo">
        <img
          src="{{ settings.logo | image_url: width: 240 }}"
          alt="{{ shop.name }}"
          width="120"
          height="32"
          loading="eager"
        >
      </a>
    {% else %}
      <a href="{{ routes.root_url }}" class="brickline-header__logo brickline-header__logo--placeholder">
        <span>Logo</span>
      </a>
    {% endif %}

    {% if menu %}
      <nav class="brickline-header__nav" aria-label="Main menu">
        {% for link in menu.links limit: 8 %}
          {% unless link.title == 'Home' %}
            {% if link.links.size > 0 %}
              <div class="brickline-header__nav-item">
                <button
                  type="button"
                  class="brickline-header__nav-link brickline-header__nav-link--has-submenu"
                  aria-haspopup="true"
                  aria-expanded="false"
                  aria-controls="brickline-header-submenu-{{ section.id }}-{{ forloop.index }}"
                >
                  {{ link.title }}
                </button>
                <div class="brickline-header__submenu" id="brickline-header-submenu-{{ section.id }}-{{ forloop.index }}">
                  <div class="brickline-header__submenu-top">
                    {% if settings.logo %}
                      <a href="{{ routes.root_url }}" class="brickline-header__submenu-logo">
                        <img
                          src="{{ settings.logo | image_url: width: 240 }}"
                          alt="{{ shop.name }}"
                          width="120"
                          height="32"
                          loading="lazy"
                        >
                      </a>
                    {% else %}
                      <a href="{{ routes.root_url }}" class="brickline-header__submenu-logo brickline-header__submenu-logo--placeholder">
                        <span>{{ shop.name }}</span>
                      </a>
                    {% endif %}
                    <button type="button" class="brickline-header__submenu-close" aria-label="Close menu">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                    </button>
                  </div>
                  <ul class="brickline-header__submenu-list">
                    {% for child_link in link.links %}
                      <li>
                        <a href="{{ child_link.url }}" class="brickline-header__submenu-link">
                          <span>{{ child_link.title }}</span>
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg>
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              </div>
            {% else %}
              <a href="{{ link.url }}" class="brickline-header__nav-link">
                {{ link.title }}
              </a>
            {% endif %}
          {% endunless %}
        {% endfor %}
      </nav>
      <div class="brickline-header__backdrop"></div>
    {% endif %}

    <search-button class="brickline-header__search">
      <button
        type="button"
        on:click="#search-modal/showDialog"
        class="brickline-header__search-trigger"
        aria-haspopup="dialog"
        aria-label="{{ 'content.search_input_label' | t }}"
      >
        <svg class="brickline-header__search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M21 21l-4.3-4.3"></path>
        </svg>
        <span class="brickline-header__search-label">{{ section.settings.search_placeholder | default: 'Search sets…' }}</span>
      </button>
    </search-button>

    <a
      href="{{ section.settings.wishlist_link | default: '#' }}"
      class="brickline-header__icon-btn brickline-header__icon-btn--wishlist"
      aria-label="Wishlist"
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M12.1 8.64l-.1.1-.1-.1C10.14 6.6 7.1 6.6 5.14 8.5c-2 2-2 5.3 0 7.3l6.6 6.5c.15.15.4.15.55 0l6.6-6.5c2-2 2-5.3 0-7.3-1.96-1.9-5-1.9-6.9.14z"></path>
      </svg>
      {% comment %}
        Filled in by brickline-wishlist.js from localStorage. Starts hidden so a
        shopper with an empty list never sees a "0", and so the cached header
        markup doesn't flash a stale number.
      {% endcomment %}
      <span
        class="brickline-header__badge"
        data-wishlist-count
        aria-hidden="true"
        hidden
      ></span>
    </a>

    {% if settings.cart_type == 'drawer' and template.name != 'cart' %}
      <button
        type="button"
        on:click="#cart-drawer/toggle"
        class="brickline-header__icon-btn brickline-header__icon-btn--cart"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="cart-drawer"
        aria-label="Bag"
        data-testid="cart-drawer-trigger"
      >
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 8h12l-1 12H7L6 8z"></path>
          <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
        </svg>
      </button>
    {% else %}
      <a
        href="{{ routes.cart_url }}"
        class="brickline-header__icon-btn brickline-header__icon-btn--cart"
        aria-label="Bag"
      >
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 8h12l-1 12H7L6 8z"></path>
          <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
        </svg>
      </a>
    {% endif %}
  </div>

  {% if menu %}
    <div class="brickline-header__mobile-menu" id="brickline-header-menu-{{ section.id }}" hidden>
      <nav class="brickline-header__mobile-nav" aria-label="Main menu">
        {% for link in menu.links limit: 8 %}
          {% unless link.title == 'Home' %}
            {% if link.links.size > 0 %}
              <div class="brickline-header__mobile-item">
                <button
                  type="button"
                  class="brickline-header__mobile-link brickline-header__mobile-link--has-submenu"
                  aria-expanded="false"
                  aria-controls="brickline-header-mobile-submenu-{{ section.id }}-{{ forloop.index }}"
                >
                  {{ link.title }}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg>
                </button>
                <ul class="brickline-header__mobile-submenu" id="brickline-header-mobile-submenu-{{ section.id }}-{{ forloop.index }}" hidden>
                  {% for child_link in link.links %}
                    <li>
                      <a href="{{ child_link.url }}" class="brickline-header__mobile-submenu-link">
                        {{ child_link.title }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% else %}
              <a href="{{ link.url }}" class="brickline-header__mobile-link">
                {{ link.title }}
              </a>
            {% endif %}
          {% endunless %}
        {% endfor %}
      </nav>
    </div>
  {% endif %}
</brickline-header-component>

<script
  src="{{ 'brickline-header.js' | asset_url }}"
  type="module"
></script>

{% stylesheet %}
  .brickline-header {
    background: var(--header-bg);
    color: var(--header-text);
    position: relative;
  }

  .brickline-header__inner {
    display: flex;
    align-items: center;
    gap: 18px;

    @media screen and (max-width: 749px) {
      gap: 8px;
    }
  }

  .brickline-header__menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    order: -1;
    background: none;
    border: none;
    border-radius: 50%;
    padding: 0;
    color: currentColor;
    cursor: pointer;
    transition: background 150ms ease;

    @media screen and (max-width: 749px) {
      display: flex;
    }
  }

  .brickline-header__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: auto;
    height: 55px;
    flex-shrink: 0;
    text-decoration: none;

    @media screen and (max-width: 749px) {
      width: auto;
      height: 28px;
    }
  }

  .brickline-header__logo img {
    display: block;
    max-width: 100%;
    max-height: 100%;
  }

  .brickline-header__logo--placeholder {
    background: rgba(0, 0, 0, 0.15);
    border-radius: 4px;
  }

  .brickline-header__logo--placeholder span {
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: currentColor;
    opacity: 0.6;
  }

  .brickline-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    flex: 1;
    min-width: 0;
    padding-left:32px;

    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .brickline-header__nav-item {
    position: relative;
  }

  .brickline-header__nav-link {
    display: inline-flex;
    align-items: center;
    background: none;
    border: none;
    padding: 0;
    color: currentColor;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 500;
    font-size: 16px;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .brickline-header__submenu {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    z-index: 100;
    width: min(420px, 86vw);
    overflow-y: auto;
    background: var(--surface-page, #ffffff);
    color: var(--text-default, #141414);
    box-shadow: var(--shadow-md, 0px 1px 2px rgba(0,0,0,0.1), 0px 4px 12px rgba(0,0,0,0.08));
    opacity: 0;
    visibility: hidden;
    transform: translateX(-100%);
    transition: opacity 300ms ease, transform 300ms ease, visibility 300ms ease;
    pointer-events: none;
  }

  .brickline-header__nav-item.is-open .brickline-header__submenu {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    pointer-events: auto;
  }

  .brickline-header__backdrop {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(0, 0, 0, 0.4);
    opacity: 0;
    visibility: hidden;
    transition: opacity 300ms ease, visibility 300ms ease;
    pointer-events: none;
  }

  .brickline-header__backdrop.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .brickline-header__submenu {
      transition: none;
    }
  }

  .brickline-header__submenu-top {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    background: var(--surface-page, #ffffff);
    border-bottom: 1px solid rgb(from var(--text-default, #141414) r g b / 0.1);
  }

  .brickline-header__submenu-logo {
    display: flex;
    align-items: center;
    width: auto;
    height: 32px;
    text-decoration: none;
  }

  .brickline-header__submenu-logo img {
    display: block;
    max-width: 100%;
    max-height: 100%;
  }

  .brickline-header__submenu-logo--placeholder span {
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 800;
    font-size: 16px;
    color: var(--text-default, #141414);
  }

  .brickline-header__submenu-close {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    background: none;
    border: none;
    border-radius: 50%;
    padding: 0;
    color: var(--text-default, #141414);
    cursor: pointer;
    transition: background 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .brickline-header__submenu-close:hover {
      background: var(--surface-muted, #f2f2f2);
    }
  }

  .brickline-header__submenu-list {
    display: flex;
    flex-direction: column;
    padding: 8px 8px 24px;
  }

  .brickline-header__submenu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 24px;
    border-radius: 6px;
    color: currentColor;
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-weight: 500;
    font-size: 16px;
    text-decoration: none;
  }

  .brickline-header__submenu-link svg {
    flex-shrink: 0;
    opacity: 0.5;
  }

  @media (hover: hover) and (pointer: fine) {
    .brickline-header__submenu-link:hover {
      background: var(--surface-muted, #f2f2f2);
    }
  }

  .brickline-header__search {
    display: block;
    flex-shrink: 0;

    @media screen and (max-width: 749px) {
      margin-inline-start: auto;
    }
  }

  .brickline-header__search-trigger {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    width: 200px;
    background: var(--surface-page, #ffffff);
    border: 1px solid;
    border-radius: var(--radius-pill, 999px);
    padding: 10px 18px;
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 14px;
    color: var(--text-subtle, #636363);
    text-align: left;
    cursor: pointer;
    transition: filter 150ms ease;

    @media screen and (max-width: 749px) {
      width: 40px;
      height: 40px;
      padding: 0;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
  }

  .brickline-header__search-label {
    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .brickline-header__search-icon {
    flex-shrink: 0;
    display: block;
  }

  .brickline-header__badge {
    position: absolute;
    top: 0;
    inset-inline-end: 0;
    min-width: 16px;
    height: 16px;
    padding-inline: 4px;
    box-sizing: border-box;
    border-radius: 999px;
    background: var(--status-discount-red, #dd0000);
    color: var(--text-inverse, #ffffff);
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 10px;
    line-height: 16px;
    text-align: center;
  }

  .brickline-header__badge[hidden] {
    display: none;
  }

  .brickline-header__icon-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: none;
    border: none;
    border-radius: 50%;
    padding: 0;
    color: currentColor;
    transition: background 150ms ease;
    cursor: pointer;
    text-decoration: none;
  }

  .brickline-header__icon-btn--wishlist {
    width: 40px;
    height: 40px;
  }

  .brickline-header__icon-btn--cart {
    width: 44px;
    height: 44px;
  }

  @media (hover: hover) and (pointer: fine) {
    .brickline-header__search-trigger:hover {
      filter: brightness(0.96);
    }

    .brickline-header__icon-btn:hover,
    .brickline-header__menu-toggle:hover {
      background: rgb(from currentColor r g b / 0.1);
    }
  }

  .brickline-header__mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 20;
    background: var(--header-bg);
    box-shadow: var(--shadow-md, 0px 1px 2px rgba(0,0,0,0.1), 0px 4px 12px rgba(0,0,0,0.08));
  }

  .brickline-header__mobile-nav {
    display: flex;
    flex-direction: column;
    padding: 8px 24px 20px;
  }

  .brickline-header__mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 14px 0;
    border-bottom: 1px solid rgb(from currentColor r g b / 0.15);
    color: currentColor;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    text-decoration: none;
  }

  .brickline-header__mobile-link:last-child {
    border-bottom: none;
  }

  .brickline-header__mobile-item {
    border-bottom: 1px solid rgb(from currentColor r g b / 0.15);
  }

  .brickline-header__mobile-item:last-child {
    border-bottom: none;
  }

  .brickline-header__mobile-link--has-submenu {
    width: 100%;
    justify-content: space-between;
    background: none;
    border: none;
    border-bottom: none;
    cursor: pointer;
  }

  .brickline-header__mobile-link--has-submenu svg {
    flex-shrink: 0;
    transition: transform 200ms ease;
  }

  .brickline-header__mobile-item.is-open .brickline-header__mobile-link--has-submenu svg {
    transform: rotate(90deg);
  }

  .brickline-header__mobile-submenu {
    display: flex;
    flex-direction: column;
    padding: 0 0 12px 12px;
  }

  .brickline-header__mobile-submenu-link {
    padding: 10px 0;
    color: currentColor;
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-weight: 500;
    font-size: 13px;
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brickline header",
  "class": "header-section",
  "tag": "header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search sets…"
    },
    {
      "type": "url",
      "id": "wishlist_link",
      "label": "Wishlist link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-yellow"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Brickline header"
    }
  ]
}
{% endschema %}
