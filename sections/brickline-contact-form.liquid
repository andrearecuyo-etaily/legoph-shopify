{% comment %}
  Contact form built from blocks so merchants can add, remove and reorder fields
  without touching Liquid. Posts through Shopify's {% form 'contact' %}, which
  emails the shop's customer-service address.

  Shopify treats contact[email], contact[name], contact[phone] and contact[body]
  specially; every other contact[...] key is passed through into the email body,
  which is how the topic/address fields below arrive.
{% endcomment %}

<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">

<div
  class="contact-form brickline-section spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}; --contact-width: {{ section.settings.content_width }}px;"
>
  <div class="contact-form__inner">
    {% if section.settings.back_label != blank %}
      <a
        href="{{ section.settings.back_link | default: routes.root_url }}"
        class="contact-form__back"
      >
        &lsaquo; {{ section.settings.back_label }}
      </a>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="contact-form__heading">{{ section.settings.heading }}</h1>
    {% endif %}

    {% form 'contact', class: 'contact-form__form' %}
      {% if form.posted_successfully? %}
        <p
          class="contact-form__success"
          role="status"
        >
          {{ section.settings.success_message | default: "Thanks — we've got your message and will be in touch." }}
        </p>
      {% else %}
        {% if form.errors %}
          <div
            class="contact-form__errors"
            role="alert"
          >
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="contact-form__fields">
          {% for block in section.blocks %}
            {% liquid
              assign field_id = 'contact-' | append: section.id | append: '-' | append: block.id
              assign field_name = 'contact[' | append: block.settings.label | append: ']'

              # Map the three keys Shopify handles natively.
              case block.settings.field_key
                when 'email'
                  assign field_name = 'contact[email]'
                when 'phone'
                  assign field_name = 'contact[phone]'
                when 'body'
                  assign field_name = 'contact[body]'
              endcase
            %}

            {% case block.type %}
              {% when 'heading' %}
                <div
                  class="contact-form__group"
                  {{ block.shopify_attributes }}
                >
                  <h2 class="contact-form__group-heading">{{ block.settings.text }}</h2>
                  {% if block.settings.note != blank %}
                    <p class="contact-form__group-note">{{ block.settings.note }}</p>
                  {% endif %}
                </div>

              {% when 'paragraph' %}
                <div
                  class="contact-form__group contact-form__prose"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.text }}
                </div>

              {% when 'select' %}
                <div
                  class="contact-form__field contact-form__field--{{ block.settings.width }}"
                  {{ block.shopify_attributes }}
                >
                  <label for="{{ field_id }}">{{ block.settings.label }}</label>
                  <select
                    id="{{ field_id }}"
                    name="{{ field_name }}"
                    {% if block.settings.required %}
                      required
                    {% endif %}
                  >
                    {% assign options = block.settings.options | newline_to_br | split: '<br />' %}
                    {% for option in options %}
                      {% assign trimmed = option | strip %}
                      {% if trimmed != blank %}
                        <option value="{{ trimmed | escape }}">{{ trimmed }}</option>
                      {% endif %}
                    {% endfor %}
                  </select>
                </div>

              {% when 'textarea' %}
                <div
                  class="contact-form__field contact-form__field--full"
                  {{ block.shopify_attributes }}
                >
                  <label for="{{ field_id }}">{{ block.settings.label }}</label>
                  {% if block.settings.help != blank %}
                    <span class="contact-form__help">{{ block.settings.help }}</span>
                  {% endif %}
                  <textarea
                    id="{{ field_id }}"
                    name="{{ field_name }}"
                    rows="5"
                    {% if block.settings.required %}
                      required
                    {% endif %}
                  ></textarea>
                </div>

              {% else %}
                <div
                  class="contact-form__field contact-form__field--{{ block.settings.width }}"
                  {{ block.shopify_attributes }}
                >
                  <label for="{{ field_id }}">{{ block.settings.label }}</label>
                  <input
                    id="{{ field_id }}"
                    type="{{ block.settings.input_type | default: 'text' }}"
                    name="{{ field_name }}"
                    {% if block.settings.field_key == 'email' %}
                      value="{{ customer.email | default: form.email }}"
                      autocomplete="email"
                    {% endif %}
                    {% if block.settings.required %}
                      required
                    {% endif %}
                  >
                </div>
            {% endcase %}
          {% endfor %}
        </div>

        <button
          type="submit"
          class="contact-form__submit"
        >
          {{ section.settings.submit_label | default: 'Send' }}
        </button>
      {% endif %}
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .contact-form__inner {
    width: 100%;
    max-width: var(--contact-width, 700px);
    margin-inline: auto;
    padding-inline: 20px;
  }

  .contact-form__back {
    display: inline-block;
    margin-block-end: 16px;
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 14px;
    text-decoration: underline;
  }

  .contact-form__heading {
    margin: 0 0 32px;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 24px;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .contact-form__heading {
      font-size: 30px;
    }
  }

  .contact-form__form {
    margin: 0;
  }

  .contact-form__fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media screen and (min-width: 600px) {
    .contact-form__fields {
      grid-template-columns: 1fr 1fr;
    }

    .contact-form__field--half {
      grid-column: span 1;
    }
  }

  .contact-form__field--full,
  .contact-form__group {
    grid-column: 1 / -1;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    grid-column: 1 / -1;
  }

  .contact-form__field label {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 13px;
    color: var(--text-default, #141414);
  }

  .contact-form__help {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 13px;
    color: var(--text-subtle, #636363);
  }

  .contact-form__field input,
  .contact-form__field select,
  .contact-form__field textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 14px;
    border: 1px solid var(--color-border-default, #d9d9d9);
    border-radius: 0;
    background: var(--surface-page, #ffffff);
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 14px;
    color: var(--text-default, #141414);
  }

  .contact-form__field textarea {
    resize: vertical;
  }

  .contact-form__group {
    margin-block-start: 16px;
  }

  .contact-form__group-heading {
    margin: 0 0 8px;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 18px;
  }

  @media screen and (min-width: 750px) {
    .contact-form__group-heading {
      font-size: 20px;
    }
  }

  .contact-form__group-note,
  .contact-form__prose {
    margin: 0;
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 13px;
    color: var(--text-subtle, #636363);
    line-height: 1.6;
  }

  .contact-form__prose p {
    margin: 0 0 8px;
  }

  .contact-form__submit {
    width: 100%;
    margin-block-start: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 0;
    background: var(--brand-orange, #c3622c);
    color: var(--brand-black, #000000);
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 14px;
    padding: 15px 24px;
    cursor: pointer;
    transition: filter 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-form__submit:hover {
      filter: brightness(0.92);
    }
  }

  .contact-form__success {
    margin: 0;
    padding: 16px;
    background: var(--surface-tertiary, #f7f7f7);
    border-inline-start: 4px solid var(--status-success-green, #008439);
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 14px;
  }

  .contact-form__errors {
    margin-block-end: 16px;
    padding: 16px;
    background: var(--surface-tertiary, #f7f7f7);
    border-inline-start: 4px solid var(--status-discount-red, #dd0000);
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 14px;
  }

  .contact-form__errors ul {
    margin: 0;
    padding-inline-start: 20px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "class": "section--contact-form",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in touch with us"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back link label",
      "default": "Back"
    },
    {
      "type": "url",
      "id": "back_link",
      "label": "Back link"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit label",
      "default": "Send"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks — we've got your message and will be in touch."
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 500,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "default": 700
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Section heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading",
          "default": "Your contact info"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note"
        }
      ]
    },
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Helpful context for the person filling in the form.</p>"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text field",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Also becomes the field name in the email you receive.",
          "default": "First name"
        },
        {
          "type": "select",
          "id": "input_type",
          "label": "Input type",
          "options": [
            { "value": "text", "label": "Text" },
            { "value": "email", "label": "Email" },
            { "value": "tel", "label": "Phone" },
            { "value": "number", "label": "Number" }
          ],
          "default": "text"
        },
        {
          "type": "select",
          "id": "field_key",
          "label": "Shopify field",
          "info": "Map to a field Shopify handles natively. Use 'Custom' for everything else.",
          "options": [
            { "value": "custom", "label": "Custom" },
            { "value": "email", "label": "Email (reply-to)" },
            { "value": "phone", "label": "Phone" }
          ],
          "default": "custom"
        },
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "options": [
            { "value": "full", "label": "Full" },
            { "value": "half", "label": "Half" }
          ],
          "default": "full"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": false
        }
      ]
    },
    {
      "type": "select",
      "name": "Dropdown",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "What do you need help with?"
        },
        {
          "type": "textarea",
          "id": "options",
          "label": "Options",
          "info": "One per line.",
          "default": "Product questions or issues\nOrder & shipping\nReturns & refunds\nAccount & rewards"
        },
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "options": [
            { "value": "full", "label": "Full" },
            { "value": "half", "label": "Half" }
          ],
          "default": "full"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": false
        }
      ]
    },
    {
      "type": "textarea",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "How can we help you?"
        },
        {
          "type": "text",
          "id": "help",
          "label": "Helper text",
          "default": "Type out your issue or ask a question…"
        },
        {
          "type": "select",
          "id": "field_key",
          "label": "Shopify field",
          "options": [
            { "value": "body", "label": "Message body" },
            { "value": "custom", "label": "Custom" }
          ],
          "default": "body"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact form",
      "blocks": [
        { "type": "select" },
        { "type": "heading", "settings": { "text": "Your contact info" } },
        { "type": "text", "settings": { "label": "First name", "width": "half", "required": true } },
        { "type": "text", "settings": { "label": "Last name", "width": "half" } },
        {
          "type": "text",
          "settings": {
            "label": "Email",
            "input_type": "email",
            "field_key": "email",
            "required": true
          }
        },
        { "type": "textarea" }
      ]
    }
  ]
}
{% endschema %}
