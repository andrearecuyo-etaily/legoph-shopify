{% comment %}
  Plain text columns — used for "Call us / Send us a letter" style blocks and
  any other multi-column prose. Each column is a block with a heading and
  rich text, so merchants control both the copy and the column count.
{% endcomment %}

<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">

<div
  class="text-columns brickline-section spacing-style{% if section.settings.dividers %} text-columns--dividers{% endif %}"
  style="{% render 'spacing-padding', settings: section.settings %}; --columns-width: {{ section.settings.content_width }}px; --cols-mobile: 1; --cols-tablet: {{ section.settings.columns_tablet }}; --cols-desktop: {{ section.settings.columns }};"
>
  <div class="text-columns__inner">
    {% if section.settings.heading != blank %}
      <h2 class="text-columns__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="text-columns__grid brickline-grid">
      {% for block in section.blocks %}
        <div
          class="text-columns__column"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.heading != blank %}
            <h3 class="text-columns__column-heading">{{ block.settings.heading }}</h3>
          {% endif %}
          {% if block.settings.body != blank %}
            <div class="text-columns__body rte">{{ block.settings.body }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .text-columns__inner {
    width: 100%;
    max-width: var(--columns-width, 900px);
    margin-inline: auto;
    padding-inline: 20px;
  }

  .text-columns__heading {
    margin: 0 0 24px;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 22px;
  }

  .text-columns__grid {
    gap: 32px;
  }

  @media screen and (min-width: 750px) {
    .text-columns__grid {
      gap: 48px;
    }
  }

  .text-columns__column-heading {
    margin: 0 0 20px;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 20px;
  }

  .text-columns__body {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 14px;
    color: var(--text-subtle, #636363);
    line-height: 1.7;
  }

  .text-columns__body p {
    margin: 0 0 16px;
  }

  .text-columns__body > :last-child {
    margin-block-end: 0;
  }

  .text-columns__body strong {
    color: var(--text-default, #141414);
  }

  /* Dividers only make sense once the columns actually sit side by side. */
  @media screen and (min-width: 750px) {
    .text-columns--dividers .text-columns__column + .text-columns__column {
      border-inline-start: 1px solid var(--color-border-default, #d9d9d9);
      padding-inline-start: 48px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Text columns",
  "class": "section--text-columns",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns — desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns — tablet",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "dividers",
      "label": "Divider between columns",
      "default": true
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 600,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "default": 900
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Call us"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p><strong>Brickline Customer Service</strong></p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text columns",
      "blocks": [{ "type": "column" }, { "type": "column" }]
    }
  ]
}
{% endschema %}
