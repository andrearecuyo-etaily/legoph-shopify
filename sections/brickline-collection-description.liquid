{% liquid
  assign heading = section.settings.heading | default: collection.title
  assign body = section.settings.body
  if body == blank
    assign body = collection.description
  endif
%}

<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">

{% if heading != blank or body != blank %}
  <div
    class="collection-description brickline-section spacing-style"
    style="{% render 'spacing-padding', settings: section.settings %}"
  >
    <div class="brickline-container">
      {% if heading != blank %}
        <h1 class="collection-description__heading">{{ heading }}</h1>
      {% endif %}

      {% if body != blank %}
        {% if section.settings.collapsible %}
          <details class="collection-description__collapsible">
            <summary class="collection-description__summary">
              <div class="collection-description__body collection-description__body--clamped">{{ body }}</div>
              <span class="collection-description__more">Read more</span>
            </summary>
            <div class="collection-description__body collection-description__body--full">{{ body }}</div>
          </details>
        {% else %}
          <div class="collection-description__body">{{ body }}</div>
        {% endif %}
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .collection-description {
    background: var(--surface-tertiary, #f7f7f7);
  }

  .collection-description__heading {
    margin: 0 0 8px;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 800;
    font-size: 18px;
  }

  .collection-description__body {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 13px;
    color: var(--text-subtle, #636363);
    line-height: 1.6;
  }

  .collection-description__body p {
    margin: 0 0 8px;
  }

  .collection-description__body > :last-child {
    margin-block-end: 0;
  }

  .collection-description__summary {
    list-style: none;
    cursor: pointer;
  }

  .collection-description__summary::-webkit-details-marker {
    display: none;
  }

  .collection-description__body--clamped {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .collection-description__more {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 13px;
    color: var(--text-link, #005ad2);
    text-decoration: underline;
  }

  .collection-description__body--full {
    display: none;
  }

  .collection-description__collapsible[open] .collection-description__summary {
    display: none;
  }

  .collection-description__collapsible[open] .collection-description__body--full {
    display: block;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection description",
  "class": "section--collection-description",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Defaults to the collection title."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "info": "Defaults to the collection description."
    },
    {
      "type": "checkbox",
      "id": "collapsible",
      "label": "Clamp to 3 lines with a Read more toggle",
      "default": false
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Collection description"
    }
  ]
}
{% endschema %}
