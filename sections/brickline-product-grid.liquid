{% comment %}
  A plain grid of Brickline product cards from a chosen collection. Unlike
  brickline-collection-grid this has no filters, sort or pagination — it's for
  dropping a fixed row of products onto a content page ("Most Popular" on the
  Free Shipping page, for one).
{% endcomment %}

{% liquid
  assign grid_collection = section.settings.collection
  assign limit = section.settings.products_to_show | default: 5
%}

<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-product-card.css' | asset_url }}">

<div
  class="product-grid brickline-section spacing-style section section--{{ section.settings.section_width }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --cols-mobile: {{ section.settings.columns_mobile }}; --cols-tablet: {{ section.settings.columns_tablet }}; --cols-desktop: {{ section.settings.columns }}; --brickline-card-radius: {{ settings.brickline_card_radius }}px;"
>
  {% if section.settings.heading != blank %}
    <h2 class="product-grid__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  {% if grid_collection != blank and grid_collection.products.size > 0 %}
    <div class="product-grid__items brickline-grid">
      {% for product in grid_collection.products limit: limit %}
        {% render 'brickline-product-card', product: product, show_meta: section.settings.show_meta %}
      {% endfor %}
    </div>

    {% if section.settings.link_label != blank %}
      <a
        href="{{ section.settings.link_url | default: grid_collection.url }}"
        class="product-grid__link"
      >
        {{ section.settings.link_label }} &rsaquo;
      </a>
    {% endif %}
  {% else %}
    <p class="product-grid__empty">Pick a collection in the section settings to show products here.</p>
  {% endif %}
</div>

<script
  src="{{ 'brickline-cart-actions.js' | asset_url }}"
  type="module"
></script>

{% stylesheet %}
  .product-grid__heading {
    margin: 0 0 20px;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 600;
    font-size: 24px;
  }

  @media screen and (min-width: 750px) {
    .product-grid__heading {
      font-size: 28px;
    }
  }

  .product-grid__items {
    gap: 20px;
  }

  .product-grid__link {
    display: inline-block;
    margin-block-start: 20px;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 13px;
    color: var(--text-link, #005ad2);
    text-decoration: none;
  }

  .product-grid__empty {
    margin: 0;
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 14px;
    color: var(--text-meta, #939393);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product grid",
  "class": "section--product-grid",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Most Popular"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_meta",
      "label": "Show age / pieces row",
      "default": true
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns — desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns — tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns — mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link",
      "info": "Defaults to the collection."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product grid"
    }
  ]
}
{% endschema %}
