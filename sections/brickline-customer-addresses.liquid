{% comment %}
  Address book for classic customer accounts. Uses Shopify's `customer_address`
  form type, which handles create, update and delete through the same endpoint.
{% endcomment %}

<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-account.css' | asset_url }}">

<div
  class="account brickline-section spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}; --account-width: {{ section.settings.content_width }}px;"
>
  <div class="account__inner">
    <div class="account__header">
      <h1 class="account__heading">{{ section.settings.heading | default: 'My Addresses' }}</h1>
      <span class="account__meta">{{ customer.addresses_count }} saved</span>
    </div>

    <div class="account__layout">
      {% render 'brickline-account-nav', current: 'addresses' %}

      <div>
        {% paginate customer.addresses by 10 %}
          <div class="account__panel">
            <h2 class="account__panel-heading">Saved addresses</h2>

            {% if customer.addresses.size > 0 %}
              <div class="account__address-grid">
                {% for address in customer.addresses %}
                  <div class="account__address">
                    <span class="account__address-title">
                      {{ address.first_name }} {{ address.last_name }}
                      {%- if address == customer.default_address %} · Default{% endif -%}
                    </span>
                    {{ address | format_address }}

                    <div class="account__actions">
                      <details>
                        <summary class="account__button account__button--secondary">Edit</summary>
                        {% form 'customer_address', address, class: 'account__form' %}
                          {% render 'brickline-address-fields', address: address, id_prefix: address.id %}
                          <div class="account__form-field account__form-field--full">
                            <label>
                              <input
                                type="checkbox"
                                name="address[default]"
                                value="1"
                                {% if address == customer.default_address %}
                                  checked
                                {% endif %}
                              >
                              Set as default address
                            </label>
                          </div>
                          <div class="account__actions account__form-field--full">
                            <button
                              type="submit"
                              class="account__button"
                            >
                              Save
                            </button>
                            <button
                              type="button"
                              class="account__button account__button--secondary"
                              data-address-delete
                              data-address-url="{{ address.url }}"
                            >
                              Delete
                            </button>
                          </div>
                        {% endform %}
                      </details>
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% else %}
              <p class="account__empty">You haven't saved an address yet.</p>
            {% endif %}
          </div>

          {% if paginate.pages > 1 %}
            <div class="account__actions">
              {% if paginate.previous %}
                <a
                  href="{{ paginate.previous.url }}"
                  class="account__button account__button--secondary"
                >
                  &lsaquo; Previous
                </a>
              {% endif %}
              {% if paginate.next %}
                <a
                  href="{{ paginate.next.url }}"
                  class="account__button account__button--secondary"
                >
                  Next &rsaquo;
                </a>
              {% endif %}
            </div>
          {% endif %}
        {% endpaginate %}

        <div class="account__panel">
          <h2 class="account__panel-heading">{{ section.settings.new_heading | default: 'Add a new address' }}</h2>
          {% form 'customer_address', customer.new_address, class: 'account__form' %}
            {% render 'brickline-address-fields', id_prefix: 'new' %}
            <div class="account__form-field account__form-field--full">
              <label>
                <input
                  type="checkbox"
                  name="address[default]"
                  value="1"
                >
                Set as default address
              </label>
            </div>
            <div class="account__actions account__form-field--full">
              <button
                type="submit"
                class="account__button"
              >
                Add address
              </button>
            </div>
          {% endform %}
        </div>
      </div>
    </div>
  </div>
</div>

<script
  src="{{ 'brickline-account.js' | asset_url }}"
  type="module"
></script>

{% schema %}
{
  "name": "Customer addresses",
  "class": "section--customer-addresses",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My Addresses"
    },
    {
      "type": "text",
      "id": "new_heading",
      "label": "New address heading",
      "default": "Add a new address"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 800,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ]
}
{% endschema %}
