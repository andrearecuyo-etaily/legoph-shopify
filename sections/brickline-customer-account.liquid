{% comment %}
  Customer dashboard: order history table plus the default address, matching the
  Account Details / Order History designs. Classic customer accounts only.
{% endcomment %}

<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-account.css' | asset_url }}">

<div
  class="account brickline-section spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}; --account-width: {{ section.settings.content_width }}px;"
>
  <div class="account__inner">
    <div class="account__header">
      <h1 class="account__heading">{{ section.settings.heading | default: 'My Account' }}</h1>
      <span class="account__meta">{{ customer.email }}</span>
    </div>

    <div class="account__layout">
      {% render 'brickline-account-nav', current: 'account' %}

      <div>
        <div class="account__panel">
          <h2 class="account__panel-heading">{{ section.settings.orders_heading | default: 'Order History' }}</h2>

          {% paginate customer.orders by section.settings.orders_per_page %}
            {% if customer.orders.size > 0 %}
              <table class="account__orders">
                <thead>
                  <tr>
                    <th scope="col">Order</th>
                    <th scope="col">Date</th>
                    <th scope="col">Items</th>
                    <th scope="col">Payment</th>
                    <th scope="col">Fulfillment</th>
                    <th scope="col">Total</th>
                    <th scope="col"><span class="visually-hidden">Order actions</span></th>
                  </tr>
                </thead>
                <tbody>
                  {% for order in customer.orders %}
                    <tr>
                      <td data-label="Order">
                        <a href="{{ order.customer_url }}">{{ order.name }}</a>
                      </td>
                      <td data-label="Date">{{ order.created_at | date: '%d %b %Y' }}</td>
                      <td data-label="Items">{{ order.item_count }}</td>
                      <td data-label="Payment">
                        <span class="account__status account__status--{{ order.financial_status }}">
                          {{- order.financial_status_label -}}
                        </span>
                      </td>
                      <td data-label="Fulfillment">
                        <span class="account__status account__status--{{ order.fulfillment_status }}">
                          {{- order.fulfillment_status_label -}}
                        </span>
                      </td>
                      <td data-label="Total">{{ order.total_price | money }}</td>
                      <td data-label="">
                        <a
                          href="{{ order.customer_url }}"
                          class="account__button account__button--secondary"
                        >
                          View Order
                        </a>
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>

              {% if paginate.pages > 1 %}
                <div class="account__actions">
                  {% if paginate.previous %}
                    <a
                      href="{{ paginate.previous.url }}"
                      class="account__button account__button--secondary"
                    >
                      &lsaquo; Previous
                    </a>
                  {% endif %}
                  {% if paginate.next %}
                    <a
                      href="{{ paginate.next.url }}"
                      class="account__button account__button--secondary"
                    >
                      Next &rsaquo;
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            {% else %}
              <p class="account__empty">
                {{ section.settings.empty_orders | default: "You haven't placed any orders yet." }}
              </p>
              <div class="account__actions">
                <a
                  href="{{ routes.all_products_collection_url }}"
                  class="account__button"
                >
                  Start shopping
                </a>
              </div>
            {% endif %}
          {% endpaginate %}
        </div>

        <div class="account__panel">
          <h2 class="account__panel-heading">{{ section.settings.address_heading | default: 'Default Address' }}</h2>
          {% if customer.default_address %}
            <div class="account__address">
              <span class="account__address-title">{{ customer.default_address.name }}</span>
              {{ customer.default_address | format_address }}
            </div>
          {% else %}
            <p class="account__empty">No default address saved yet.</p>
          {% endif %}
          <div class="account__actions">
            <a
              href="{{ routes.account_addresses_url }}"
              class="account__button account__button--secondary"
            >
              Manage addresses
            </a>
          </div>
        </div>

        <div
          class="account__panel"
          id="account-details"
        >
          <h2 class="account__panel-heading">{{ section.settings.details_heading | default: 'Account Details' }}</h2>

          {% form 'customer', customer, class: 'account__form' %}
            {% if form.errors %}
              <div
                class="account__form-field--full account__errors"
                role="alert"
              >
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="account__form-field account__form-field--half">
              <label for="account-first-name">First name</label>
              <input
                id="account-first-name"
                type="text"
                name="customer[first_name]"
                value="{{ form.first_name }}"
                autocomplete="given-name"
              >
            </div>

            <div class="account__form-field account__form-field--half">
              <label for="account-last-name">Last name</label>
              <input
                id="account-last-name"
                type="text"
                name="customer[last_name]"
                value="{{ form.last_name }}"
                autocomplete="family-name"
              >
            </div>

            <div class="account__form-field account__form-field--full">
              <label for="account-email">Email</label>
              <input
                id="account-email"
                type="email"
                name="customer[email]"
                value="{{ form.email }}"
                autocomplete="email"
                required
              >
            </div>

            <div class="account__form-field account__form-field--full">
              <label for="account-phone">Phone number</label>
              <input
                id="account-phone"
                type="tel"
                name="customer[phone]"
                value="{{ form.phone }}"
                autocomplete="tel"
              >
            </div>

            <div class="account__form-field account__form-field--full account__form-field--divider">
              <label for="account-password">New password</label>
              <input
                id="account-password"
                type="password"
                name="customer[password]"
                autocomplete="new-password"
                placeholder="Leave blank to keep current password"
              >
            </div>

            <div class="account__form-field account__form-field--full">
              <label for="account-password-confirmation">Confirm new password</label>
              <input
                id="account-password-confirmation"
                type="password"
                name="customer[password_confirmation]"
                autocomplete="new-password"
                placeholder="Only needed if setting a new password"
              >
            </div>

            <div class="account__actions account__form-field--full">
              <button
                type="submit"
                class="account__button"
              >
                {{ section.settings.details_submit | default: 'Save Changes' }}
              </button>
            </div>
          {% endform %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer account",
  "class": "section--customer-account",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My Account"
    },
    {
      "type": "text",
      "id": "orders_heading",
      "label": "Orders heading",
      "default": "Order History"
    },
    {
      "type": "range",
      "id": "orders_per_page",
      "label": "Orders per page",
      "min": 5,
      "max": 50,
      "step": 5,
      "default": 20
    },
    {
      "type": "text",
      "id": "empty_orders",
      "label": "Empty orders message",
      "default": "You haven't placed any orders yet."
    },
    {
      "type": "text",
      "id": "address_heading",
      "label": "Address heading",
      "default": "Default Address"
    },
    {
      "type": "text",
      "id": "details_heading",
      "label": "Account details heading",
      "default": "Account Details"
    },
    {
      "type": "text",
      "id": "details_submit",
      "label": "Account details submit button",
      "default": "Save Changes"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 800,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ]
}
{% endschema %}
