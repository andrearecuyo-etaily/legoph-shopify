<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">

<div
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id | handleize }}"
  {% endif %}
  class="brickline-faq brickline-section spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="brickline-faq__inner">
    {% if section.settings.heading != blank %}
      <h2 class="brickline-faq__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="brickline-faq__list">
      {% for block in section.blocks %}
        <details
          class="brickline-faq__item"
          name="faq-{{ section.id }}"
          {% if forloop.first and section.settings.open_first %}
            open
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <summary class="brickline-faq__question">
            <span class="brickline-faq__question-text">{{ block.settings.question }}</span>
            <span
              class="brickline-faq__toggle"
              aria-hidden="true"
            ></span>
          </summary>
          <div class="brickline-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .brickline-faq__inner {
    width: 100%;
    max-width: 900px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  .brickline-faq__heading {
    margin: 0 0 24px;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 24px;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .brickline-faq__heading {
      font-size: 26px;
    }
  }

  .brickline-faq__list {
    display: flex;
    flex-direction: column;
  }

  .brickline-faq__item {
    border-bottom: 1px solid var(--color-border-default, #d9d9d9);
  }

  .brickline-faq__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px 4px;
    cursor: pointer;
    list-style: none;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: var(--text-default, #141414);
  }

  .brickline-faq__question::-webkit-details-marker {
    display: none;
  }

  .brickline-faq__question:focus-visible {
    outline: 2px solid var(--text-default, #141414);
    outline-offset: 2px;
  }

  /* Plus / minus toggle drawn in CSS so it flips with [open] without JS. */
  .brickline-faq__toggle {
    position: relative;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    color: var(--text-meta, #939393);
  }

  .brickline-faq__toggle::before,
  .brickline-faq__toggle::after {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 50%;
    width: 14px;
    height: 2px;
    background: currentcolor;
    transform: translateY(-50%);
    transition: opacity 150ms ease;
  }

  .brickline-faq__toggle::after {
    transform: translateY(-50%) rotate(90deg);
  }

  .brickline-faq__item[open] .brickline-faq__toggle::after {
    opacity: 0;
  }

  .brickline-faq__answer {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 14px;
    color: var(--text-subtle, #636363);
    line-height: 1.6;
    padding: 0 4px 18px;
  }

  .brickline-faq__answer > :first-child {
    margin-block-start: 0;
  }

  .brickline-faq__answer > :last-child {
    margin-block-end: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ accordion",
  "class": "section--brickline-faq",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loyalty FAQ"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Lets other sections link to this one, e.g. #rewards-faq",
      "default": "rewards-faq"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first question by default",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Is Brickline Rewards really free to join?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes — membership is completely free, with no tiers or spending limits to unlock the basics.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ accordion",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Is Brickline Rewards really free to join?",
            "answer": "<p>Yes — membership is completely free, with no tiers or spending limits to unlock the basics. Sign up in-store or online in under a minute.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How many points do I earn per purchase?",
            "answer": "<p>Silver members earn 1 point, Gold earns 2, and Platinum earns 3 for every ₱100 spent, both in-store and online.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Do my points expire?",
            "answer": "<p>Points remain valid for 24 months from the date they were earned, as long as your account stays active.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I use points and a discount code together?",
            "answer": "<p>Yes, points redemptions can be combined with most promotional discount codes at checkout.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How do I redeem my rewards?",
            "answer": "<p>Visit the Rewards Centre in your account to browse available rewards and redeem points instantly online or in-store.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
