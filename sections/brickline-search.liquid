{% liquid
  assign per_page = section.settings.products_per_page | default: 16
  assign suggestions = section.blocks | where: 'type', 'suggestion'
%}

<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-product-card.css' | asset_url }}">

<div
  class="search-results brickline-section spacing-style section section--{{ section.settings.section_width }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --cols-mobile: {{ section.settings.columns_mobile }}; --cols-tablet: {{ section.settings.columns_tablet }}; --cols-desktop: {{ section.settings.columns }}; --brickline-card-radius: {{ settings.brickline_card_radius }}px;"
>
  <form
    action="{{ routes.search_url }}"
    method="get"
    role="search"
    class="search-results__form"
  >
    <input
      type="hidden"
      name="type"
      value="product"
    >
    <label
      for="search-input-{{ section.id }}"
      class="visually-hidden"
    >
      {{ section.settings.placeholder | default: 'Search sets…' }}
    </label>
    {%- render 'brickline-icon', icon: 'search' -%}
    <input
      id="search-input-{{ section.id }}"
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ section.settings.placeholder | default: 'Search sets…' | escape }}"
      autocomplete="off"
    >
    <button
      type="submit"
      class="visually-hidden"
    >
      Search
    </button>
  </form>

  {% if search.performed %}
    {% paginate search.results by per_page %}
      <span class="search-results__count">
        Showing {{ search.results_count }}
        {%- if search.results_count == 1 %} result{% else %} results{% endif %}
        {%- if search.terms != blank %}
          for "<strong>{{ search.terms }}</strong>"
        {%- endif -%}
      </span>

      {% if search.results_count > 0 %}
        <div class="search-results__items brickline-grid">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}
              {% render 'brickline-product-card', product: item, show_meta: false %}
            {% else %}
              <a
                href="{{ item.url }}"
                class="search-results__page-card"
              >
                <span class="search-results__page-title">{{ item.title }}</span>
                {% if item.content != blank %}
                  <span class="search-results__page-excerpt">
                    {{- item.content | strip_html | truncatewords: 24 -}}
                  </span>
                {% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <nav
            class="search-results__pagination"
            aria-label="Pagination"
          >
            {% if paginate.previous %}
              <a
                href="{{ paginate.previous.url }}"
                class="search-results__page-arrow"
                rel="prev"
              >
                &lsaquo; Prev
              </a>
            {% endif %}
            {% for part in paginate.parts %}
              {% if part.is_link %}
                <a
                  href="{{ part.url }}"
                  class="search-results__page-link"
                >
                  {{ part.title }}
                </a>
              {% elsif part.title == paginate.current_page %}
                <span
                  class="search-results__page-link is-active"
                  aria-current="page"
                >
                  {{ part.title }}
                </span>
              {% else %}
                <span class="search-results__page-link">{{ part.title }}</span>
              {% endif %}
            {% endfor %}
            {% if paginate.next %}
              <a
                href="{{ paginate.next.url }}"
                class="search-results__page-arrow"
                rel="next"
              >
                Next &rsaquo;
              </a>
            {% endif %}
          </nav>
        {% endif %}
      {% else %}
        <div class="search-results__empty">
          <span class="search-results__empty-title">
            {{ section.settings.empty_title | default: 'No results found' }}
          </span>
          <span class="search-results__empty-body">
            {{ section.settings.empty_body | default: 'Try checking your spelling or use a more general term.' }}
          </span>

          {% if suggestions.size > 0 %}
            <div class="search-results__suggestions">
              {% for suggestion in suggestions %}
                <a
                  href="{{ routes.search_url }}?q={{ suggestion.settings.term | url_encode }}&type=product"
                  class="search-results__suggestion"
                  {{ suggestion.shopify_attributes }}
                >
                  {{ suggestion.settings.term }}
                </a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endpaginate %}
  {% else %}
    {% comment %} No query yet — offer the popular terms as a starting point. {% endcomment %}
    {% if suggestions.size > 0 %}
      <div class="search-results__suggestions search-results__suggestions--idle">
        <span class="search-results__suggestions-label">
          {{ section.settings.suggestions_label | default: 'Popular searches' }}
        </span>
        {% for suggestion in suggestions %}
          <a
            href="{{ routes.search_url }}?q={{ suggestion.settings.term | url_encode }}&type=product"
            class="search-results__suggestion"
            {{ suggestion.shopify_attributes }}
          >
            {{ suggestion.settings.term }}
          </a>
        {% endfor %}
      </div>
    {% endif %}
  {% endif %}
</div>

<script
  src="{{ 'brickline-cart-actions.js' | asset_url }}"
  type="module"
></script>

{% stylesheet %}
  .search-results__form {
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--color-border-default, #d9d9d9);
    border-radius: 999px;
    padding: 12px 20px;
    max-width: 480px;
    margin: 0;
  }

  .search-results__form svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: var(--text-meta, #939393);
  }

  .search-results__form input[type="search"] {
    border: none;
    outline: none;
    flex: 1;
    min-width: 0;
    background: transparent;
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 15px;
    color: var(--text-default, #141414);
  }

  .search-results__count {
    display: block;
    margin-block-start: 16px;
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 14px;
    color: var(--text-subtle, #636363);
  }

  .search-results__count strong {
    color: var(--text-default, #141414);
  }

  .search-results__items {
    gap: 20px;
    margin-block-start: 20px;
  }

  .search-results__page-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    border: 1px solid var(--color-border-default, #d9d9d9);
    text-decoration: none;
  }

  .search-results__page-title {
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: var(--text-default, #141414);
  }

  .search-results__page-excerpt {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 13px;
    color: var(--text-subtle, #636363);
    line-height: 1.6;
  }

  .search-results__pagination {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    margin-block-start: 32px;
  }

  .search-results__page-arrow,
  .search-results__page-link {
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 13px;
    color: var(--text-default, #141414);
    text-decoration: none;
    padding: 8px 12px;
  }

  .search-results__page-link.is-active {
    background: var(--brand-black, #000000);
    color: var(--text-inverse, #ffffff);
  }

  .search-results__empty {
    max-width: 640px;
    margin-inline: auto;
    padding: 40px 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .search-results__empty-title {
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 800;
    font-size: 20px;
  }

  .search-results__empty-body {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 14px;
    color: var(--text-subtle, #636363);
  }

  .search-results__suggestions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    margin-block-start: 12px;
  }

  .search-results__suggestions--idle {
    justify-content: flex-start;
    margin-block-start: 20px;
  }

  .search-results__suggestions-label {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 13px;
    color: var(--text-subtle, #636363);
    margin-inline-end: 4px;
  }

  .search-results__suggestion {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 12px;
    padding: 6px 12px;
    background: var(--surface-tertiary, #f7f7f7);
    border-radius: 999px;
    color: var(--text-default, #141414);
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .search-results__suggestion:hover {
      background: var(--surface-muted, #f2f2f2);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Search results",
  "class": "section--search-results",
  "tag": "section",
  "enabled_on": {
    "templates": ["search"]
  },
  "settings": [
    {
      "type": "text",
      "id": "placeholder",
      "label": "Search placeholder",
      "default": "Search sets…"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Results per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns — desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns — tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns — mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "text",
      "id": "suggestions_label",
      "label": "Suggestions label",
      "default": "Popular searches"
    },
    {
      "type": "text",
      "id": "empty_title",
      "label": "Empty state title",
      "default": "No results found"
    },
    {
      "type": "text",
      "id": "empty_body",
      "label": "Empty state body",
      "default": "Try checking your spelling or use a more general term."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "suggestion",
      "name": "Suggested term",
      "settings": [
        {
          "type": "text",
          "id": "term",
          "label": "Term",
          "default": "Technic"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Search results",
      "blocks": [
        { "type": "suggestion", "settings": { "term": "Everfrost" } },
        { "type": "suggestion", "settings": { "term": "Technic" } },
        { "type": "suggestion", "settings": { "term": "Exclusives" } },
        { "type": "suggestion", "settings": { "term": "City" } }
      ]
    }
  ]
}
{% endschema %}
