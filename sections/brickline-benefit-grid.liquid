<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">

<div
  class="benefit-grid brickline-section spacing-style section section--{{ section.settings.section_width }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --benefit-icon-bg: {{ section.settings.icon_background }}; --benefit-title-color: {{ section.settings.title_color }}; --cols-mobile: {{ section.settings.columns_mobile }}; --cols-tablet: {{ section.settings.columns_tablet }}; --cols-desktop: {{ section.settings.columns }};"
>
  {% if section.settings.heading != blank %}
    <h2 class="benefit-grid__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="benefit-grid__items brickline-grid">
    {% for block in section.blocks %}
      <div
        class="benefit-grid__item"
        {{ block.shopify_attributes }}
      >
        <span class="benefit-grid__icon">
          {%- render 'brickline-icon', icon: block.settings.icon -%}
        </span>
        {% if block.settings.title != blank %}
          <h3 class="benefit-grid__title">{{ block.settings.title }}</h3>
        {% endif %}
        {% if block.settings.body != blank %}
          <div class="benefit-grid__body">{{ block.settings.body }}</div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .benefit-grid__heading {
    margin: 0 0 32px;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 24px;
  }

  .benefit-grid__items {
    gap: 32px;
  }

  @media screen and (min-width: 750px) {
    .benefit-grid__items {
      gap: 40px 48px;
    }
  }

  .benefit-grid__item {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .benefit-grid__icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--benefit-icon-bg, #dd0000);
    color: var(--text-inverse, #ffffff);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .benefit-grid__icon svg {
    width: 18px;
    height: 18px;
  }

  .benefit-grid__title {
    margin: 0;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 800;
    font-size: 15px;
    text-transform: uppercase;
    color: var(--benefit-title-color, #dd0000);
  }

  .benefit-grid__body {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 14px;
    color: var(--text-subtle, #636363);
    line-height: 1.6;
  }

  .benefit-grid__body p {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Benefit grid",
  "class": "section--benefit-grid",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns — desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns — tablet",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns — mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 1
    },
    {
      "type": "color",
      "id": "icon_background",
      "label": "Icon background",
      "default": "#dd0000"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#dd0000"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "mountains", "label": "Mountains" },
            { "value": "star", "label": "Star" },
            { "value": "gift", "label": "Gift" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "document", "label": "Document" },
            { "value": "question", "label": "Question" },
            { "value": "heart", "label": "Heart" },
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" },
            { "value": "refresh", "label": "Refresh" }
          ],
          "default": "star"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "It's free to be a member"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>Sign up online or in-store and start collecting points.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefit grid",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "mountains",
            "title": "It's free to be a member",
            "body": "<p>Sign up online or in-store and start collecting points. You'll also get access to exclusive items and pre-release collections.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "star",
            "title": "Collect 3 points for every ₱100 spent",
            "body": "<p>All members earn points on every purchase, based on their tier. Silver earns 1 point, Gold earns 2, and Platinum earns 3 for every ₱100 spent.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "gift",
            "title": "Get access to online rewards",
            "body": "<p>Get access to the online Rewards Centre, where you can use your points for discounts and access exclusive rewards only available to members.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "calendar",
            "title": "Enjoy early access",
            "body": "<p>Enjoy early access to some of our most desirable products, invitations to special events, and members-only promotions like Double Points weekends.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
