{% liquid
  # Falls back to the Shopify page object so one template serves every policy /
  # content page — merchants edit the copy in the page editor, not the theme.
  assign heading = section.settings.heading
  if heading == blank
    assign heading = page.title
  endif

  assign body = section.settings.body
  if body == blank
    assign body = page.content
  endif

  assign bullets = section.blocks | where: 'type', 'bullet'
%}

<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">

<div
  class="rich-text brickline-section spacing-style rich-text--{{ section.settings.alignment }} rich-text--body-{{ section.settings.body_size }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --rich-text-width: {{ section.settings.content_width }}px;"
>
  <div class="rich-text__inner">
    {% if section.settings.show_breadcrumb %}
      <div class="rich-text__breadcrumb">
        {% render 'brickline-breadcrumb', current: heading %}
      </div>
    {% endif %}

    {% if heading != blank %}
      <h1 class="rich-text__heading">{{ heading }}</h1>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <h2 class="rich-text__subheading">{{ section.settings.subheading }}</h2>
    {% endif %}

    {% if section.settings.intro != blank %}
      <div class="rich-text__intro">{{ section.settings.intro }}</div>
    {% endif %}

    {% if bullets.size > 0 %}
      <ul class="rich-text__bullets">
        {% for bullet in bullets %}
          <li {{ bullet.shopify_attributes }}>{{ bullet.settings.text }}</li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if body != blank %}
      <div class="rich-text__body rte">{{ body }}</div>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a
        href="{{ section.settings.button_link | default: '#' }}"
        class="rich-text__button"
      >
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .rich-text__inner {
    width: 100%;
    max-width: var(--rich-text-width, 900px);
    margin-inline: auto;
    padding-inline: 20px;
  }

  .rich-text--center .rich-text__inner {
    text-align: center;
  }

  .rich-text__breadcrumb {
    margin-block-end: 24px;
    text-align: start;
  }

  .rich-text__heading {
    margin: 0 0 24px;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 800;
    font-size: 24px;
    line-height: 1.25;
  }

  @media screen and (min-width: 750px) {
    .rich-text__heading {
      margin-block-end: 32px;
      font-size: 28px;
    }
  }

  .rich-text__subheading {
    margin: 0 0 14px;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 600;
    font-size: 20px;
    line-height: 1.3;
  }

  @media screen and (min-width: 750px) {
    .rich-text__subheading {
      font-size: 28px;
    }
  }

  .rich-text__intro,
  .rich-text__body {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 14px;
    color: var(--text-subtle, #636363);
    line-height: 1.7;
  }

  /* Legal small print — the Free Shipping disclaimer, for one. */
  .rich-text--body-small .rich-text__intro,
  .rich-text--body-small .rich-text__body {
    font-size: 12px;
    color: var(--text-meta, #939393);
  }

  .rich-text__intro p,
  .rich-text__body p {
    margin: 0 0 16px;
  }

  .rich-text__body > :last-child,
  .rich-text__intro > :last-child {
    margin-block-end: 0;
  }

  .rich-text__body h2,
  .rich-text__body h3 {
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    color: var(--text-default, #141414);
    margin: 32px 0 12px;
  }

  .rich-text__body h2 {
    font-size: 20px;
  }

  .rich-text__body h3 {
    font-size: 16px;
  }

  .rich-text__body ul,
  .rich-text__body ol {
    padding-inline-start: 20px;
    line-height: 1.9;
  }

  /* Bullets stay left-aligned even when the section is centred — a centred
     list of sentences is close to unreadable. */
  .rich-text__bullets {
    text-align: start;
    max-width: 560px;
    margin: 0 auto 16px;
    padding-inline-start: 20px;
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 14px;
    color: var(--text-subtle, #636363);
    line-height: 1.9;
  }

  .rich-text--start .rich-text__bullets {
    margin-inline: 0;
  }

  .rich-text__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-block-start: 24px;
    background: var(--brand-black, #000000);
    color: var(--text-inverse, #ffffff);
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 13px;
    padding: 14px 28px;
    text-decoration: none;
    transition: filter 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .rich-text__button:hover {
      filter: brightness(1.4);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rich text",
  "class": "section--rich-text",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Heading and body fall back to the page's own title and content when left blank, so one template can serve every content page."
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Defaults to the page title."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "info": "Defaults to the page content."
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "center", "label": "Centered" },
        { "value": "start", "label": "Left" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "body_size",
      "label": "Body size",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "small", "label": "Small print" }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 600,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "default": 900
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free returns on all items"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
