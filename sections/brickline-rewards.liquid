{% comment %}
  Customer-facing ZAP rewards page — the CUSTOMER column of the ZAP Partner API
  flow diagram: enrol, check balance, redeem points, view and redeem coupons.

  Which state renders is decided in Liquid from the customer metafields the App
  Proxy endpoint writes, so there's no flash of the wrong state on load. Live
  figures (balance, coupons) are fetched client-side because they change between
  page views.

  Earn Points is deliberately absent: on an online store points accrue from an
  orders/paid webhook, not a button a shopper can press.

  See docs/zap-app-proxy-contract.md.
{% endcomment %}

{% liquid
  assign enrolled_at = customer.metafields.zap.enrolled_at
  assign mobile_masked = customer.metafields.zap.mobile_masked

  assign state = 'guest'
  if customer
    if enrolled_at != blank
      assign state = 'member'
    else
      assign state = 'enrol'
    endif
  endif
%}

<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-account.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-rewards.css' | asset_url }}">

<div
  class="rewards account brickline-section spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}; --account-width: {{ section.settings.content_width }}px;"
>
  <div class="account__inner">
    <div class="account__layout">
      {% if section.settings.show_account_nav %}
        {% render 'brickline-account-nav', current: 'rewards' %}
      {% endif %}

      <div>
        <div class="account__header">
          <h1 class="account__heading">{{ section.settings.heading | default: 'Insiders Points' }}</h1>
          {% if state == 'member' and mobile_masked != blank %}
            <span class="account__meta">{{ mobile_masked }}</span>
          {% endif %}
        </div>

        {% case state %}
          {% when 'guest' %}
            <div class="account__panel rewards__prompt">
              <h2 class="account__panel-heading">{{ section.settings.guest_heading | default: 'Sign in to see your points' }}</h2>
              <p class="account__empty">
                {{ section.settings.guest_body
                  | default: 'Your points balance, coupons and rewards live in your Brickline account.'
                }}
              </p>
              <div class="account__actions">
                <a
                  href="{{ routes.account_login_url }}"
                  class="account__button"
                >
                  Sign in
                </a>
                <a
                  href="{{ routes.account_register_url }}"
                  class="account__button account__button--secondary"
                >
                  Create account
                </a>
              </div>
            </div>

          {% when 'enrol' %}
            {% comment %} Register API, then the OTP step the diagram shows. {% endcomment %}
            <zap-enrol class="account__panel">
              <h2 class="account__panel-heading">{{ section.settings.enrol_heading | default: 'Join Brickline Rewards' }}</h2>
              <p class="account__empty">
                {{ section.settings.enrol_body
                  | default: 'Register your mobile number to start earning points on every purchase.'
                }}
              </p>

              <form
                class="account__form rewards__form"
                data-zap-enrol-form
                novalidate
              >
                <div class="account__form-field account__form-field--half">
                  <label for="zap-mobile-{{ section.id }}">Mobile number</label>
                  <input
                    id="zap-mobile-{{ section.id }}"
                    type="tel"
                    name="mobile"
                    inputmode="numeric"
                    autocomplete="tel"
                    placeholder="09XX XXX XXXX"
                    required
                  >
                </div>
                <div class="account__form-field account__form-field--half">
                  <label for="zap-pin-{{ section.id }}">Choose a PIN</label>
                  <input
                    id="zap-pin-{{ section.id }}"
                    type="password"
                    name="pin"
                    inputmode="numeric"
                    autocomplete="new-password"
                    minlength="4"
                    required
                  >
                </div>
                <div class="account__actions account__form-field--full">
                  <button
                    type="submit"
                    class="account__button"
                  >
                    Send verification code
                  </button>
                </div>
              </form>

              {% comment %} Revealed once the Register call returns a reference. {% endcomment %}
              <form
                class="account__form rewards__form"
                data-zap-otp-form
                novalidate
                hidden
              >
                <div class="account__form-field account__form-field--half">
                  <label for="zap-otp-{{ section.id }}">Verification code</label>
                  <input
                    id="zap-otp-{{ section.id }}"
                    type="text"
                    name="otp"
                    inputmode="numeric"
                    autocomplete="one-time-code"
                    required
                  >
                </div>
                <div class="account__actions account__form-field--full">
                  <button
                    type="submit"
                    class="account__button"
                  >
                    Verify and join
                  </button>
                </div>
              </form>

              <p
                class="rewards__message"
                data-zap-message
                role="status"
                hidden
              ></p>
            </zap-enrol>

          {% when 'member' %}
            <zap-dashboard class="rewards__dashboard">
              {% comment %}
                ZAP returns an array of currencies — a merchant can run more than
                one (the docs' example has Angus Points and ZAPCash). JS renders
                them in priority order, so this starts empty rather than assuming
                a single figure.
              {% endcomment %}
              <div class="account__panel rewards__balance">
                <div
                  class="rewards__currencies"
                  data-zap-currencies
                >
                  <div class="rewards__points">
                    <span class="rewards__points-value">—</span>
                    <span class="rewards__points-label">{{ section.settings.points_label | default: 'Points available' }}</span>
                  </div>
                </div>
                <span
                  class="rewards__tier"
                  data-zap-tier
                  hidden
                ></span>
              </div>

              {% comment %}
                Shown only when ZAP's auth mode wants a code for the balance
                lookup — the endpoint answers otp_required and we retry.
              {% endcomment %}
              <form
                class="account__panel account__form rewards__form"
                data-zap-balance-otp
                novalidate
                hidden
              >
                <div class="account__form-field account__form-field--half">
                  <label for="zap-balance-otp-{{ section.id }}">Enter the code we sent you</label>
                  <input
                    id="zap-balance-otp-{{ section.id }}"
                    type="text"
                    name="otp"
                    inputmode="numeric"
                    autocomplete="one-time-code"
                    required
                  >
                </div>
                <div class="account__actions account__form-field--full">
                  <button
                    type="submit"
                    class="account__button"
                  >
                    Show my points
                  </button>
                </div>
              </form>

              {% if section.settings.show_redeem_points %}
                <div class="account__panel">
                  <h2 class="account__panel-heading">{{ section.settings.redeem_heading | default: 'Redeem points' }}</h2>
                  <p class="account__empty">
                    {{ section.settings.redeem_body
                      | default: 'Turn your points into a discount to use at checkout.'
                    }}
                  </p>
                  <form
                    class="account__form rewards__form"
                    data-zap-redeem-form
                    novalidate
                  >
                    <div class="account__form-field account__form-field--half">
                      <label for="zap-amount-{{ section.id }}">Points to redeem</label>
                      <input
                        id="zap-amount-{{ section.id }}"
                        type="number"
                        name="amount"
                        min="1"
                        step="1"
                        inputmode="numeric"
                        required
                      >
                    </div>
                    <div
                      class="account__form-field account__form-field--half"
                      data-zap-redeem-otp
                      hidden
                    >
                      <label for="zap-redeem-otp-{{ section.id }}">Verification code</label>
                      <input
                        id="zap-redeem-otp-{{ section.id }}"
                        type="text"
                        name="otp"
                        inputmode="numeric"
                        autocomplete="one-time-code"
                      >
                    </div>
                    <div class="account__actions account__form-field--full">
                      <button
                        type="submit"
                        class="account__button"
                      >
                        Redeem
                      </button>
                    </div>
                  </form>
                </div>
              {% endif %}

              {% if section.settings.show_coupons %}
                <div class="account__panel">
                  <h2 class="account__panel-heading">{{ section.settings.coupons_heading | default: 'Your coupons' }}</h2>
                  <div data-zap-coupons>
                    <p class="account__empty">Loading your coupons…</p>
                  </div>
                </div>
              {% endif %}

              {% if section.settings.show_transactions %}
                <div class="account__panel">
                  <h2 class="account__panel-heading">{{ section.settings.transactions_heading | default: 'Points activity' }}</h2>
                  <div data-zap-transactions>
                    <p class="account__empty">Loading your activity…</p>
                  </div>
                  {% comment %} ZAP pages 10 at a time via an opaque marker. {% endcomment %}
                  <div class="account__actions">
                    <button
                      type="button"
                      class="account__button account__button--secondary"
                      data-zap-more
                      hidden
                    >
                      Load more
                    </button>
                  </div>
                </div>
              {% endif %}

              <p
                class="rewards__message"
                data-zap-message
                role="status"
                hidden
              ></p>
            </zap-dashboard>

        {% endcase %}
      </div>
    </div>
  </div>
</div>

<script
  src="{{ 'brickline-rewards.js' | asset_url }}"
  type="module"
></script>

{% schema %}
{
  "name": "Rewards account",
  "class": "section--rewards",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Reads live data from the ZAP App Proxy. Until that proxy is deployed the page says the programme isn't connected yet — see docs/zap-app-proxy-contract.md."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Insiders Points"
    },
    {
      "type": "checkbox",
      "id": "show_account_nav",
      "label": "Show account sidebar",
      "default": true
    },
    {
      "type": "header",
      "content": "Signed out"
    },
    {
      "type": "text",
      "id": "guest_heading",
      "label": "Heading",
      "default": "Sign in to see your points"
    },
    {
      "type": "text",
      "id": "guest_body",
      "label": "Body",
      "default": "Your points balance, coupons and rewards live in your Brickline account."
    },
    {
      "type": "header",
      "content": "Not yet enrolled"
    },
    {
      "type": "text",
      "id": "enrol_heading",
      "label": "Heading",
      "default": "Join Brickline Rewards"
    },
    {
      "type": "text",
      "id": "enrol_body",
      "label": "Body",
      "default": "Register your mobile number to start earning points on every purchase."
    },
    {
      "type": "header",
      "content": "Member"
    },
    {
      "type": "text",
      "id": "points_label",
      "label": "Points label",
      "default": "Points available"
    },
    {
      "type": "checkbox",
      "id": "show_redeem_points",
      "label": "Show redeem points",
      "default": true
    },
    {
      "type": "text",
      "id": "redeem_heading",
      "label": "Redeem heading",
      "default": "Redeem points"
    },
    {
      "type": "text",
      "id": "redeem_body",
      "label": "Redeem body",
      "default": "Turn your points into a discount code to use at checkout."
    },
    {
      "type": "checkbox",
      "id": "show_coupons",
      "label": "Show coupons",
      "default": true
    },
    {
      "type": "text",
      "id": "coupons_heading",
      "label": "Coupons heading",
      "default": "Your coupons"
    },
    {
      "type": "checkbox",
      "id": "show_transactions",
      "label": "Show points activity",
      "default": true
    },
    {
      "type": "text",
      "id": "transactions_heading",
      "label": "Activity heading",
      "default": "Points activity"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 800,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "default": 1000
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ]
}
{% endschema %}
