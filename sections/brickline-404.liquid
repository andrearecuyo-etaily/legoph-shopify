{% liquid
  assign links = section.blocks | where: 'type', 'link'
%}

<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">

<div
  class="not-found brickline-section spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}; --numeral-fill: {{ section.settings.numeral_color }}; --numeral-stroke: {{ section.settings.numeral_stroke_color }};"
>
  {% if section.settings.show_decoration %}
    {% comment %}
      Decorative scattered bricks. Purely presentational, so they're hidden from
      assistive tech and dropped entirely on small screens where they would
      collide with the copy.
    {% endcomment %}
    <div
      class="not-found__bricks"
      aria-hidden="true"
    >
      <span class="not-found__brick not-found__brick--1"><i></i><i></i></span>
      <span class="not-found__brick not-found__brick--2"><i></i><i></i><i></i><i></i></span>
      <span class="not-found__brick not-found__brick--3"><i></i><i></i><i></i></span>
      <span class="not-found__brick not-found__brick--4"><i></i><i></i><i></i><i></i></span>
      <span class="not-found__brick not-found__brick--5"><i></i></span>
    </div>
  {% endif %}

  <div class="not-found__inner">
    <span class="not-found__numeral">{{ section.settings.numeral | default: '404' }}</span>

    {% if section.settings.heading != blank %}
      <h1 class="not-found__heading">{{ section.settings.heading }}</h1>
    {% endif %}

    {% if section.settings.body != blank %}
      <p class="not-found__body">{{ section.settings.body }}</p>
    {% endif %}

    <div class="not-found__actions">
      {% if section.settings.primary_label != blank %}
        <a
          href="{{ section.settings.primary_link | default: routes.root_url }}"
          class="not-found__button not-found__button--primary"
        >
          {{ section.settings.primary_label }}
        </a>
      {% endif %}
      {% if section.settings.secondary_label != blank %}
        <a
          href="{{ section.settings.secondary_link | default: routes.search_url }}"
          class="not-found__button not-found__button--outline"
        >
          {{ section.settings.secondary_label }}
        </a>
      {% endif %}
    </div>

    {% if links.size > 0 %}
      <div class="not-found__links">
        {% for link in links %}
          <a
            href="{{ link.settings.link | default: '#' }}"
            class="not-found__link"
            {{ link.shopify_attributes }}
          >
            {{ link.settings.label }}
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .not-found {
    position: relative;
    overflow: hidden;
    padding-inline: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
  }

  .not-found__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .not-found__inner {
      gap: 24px;
    }
  }

  .not-found__numeral {
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 800;
    line-height: 1;
    color: var(--numeral-fill, #ffd400);
    -webkit-text-stroke: 3px var(--numeral-stroke, #000000);
    /* Scales with the viewport so the numeral never overflows a small phone. */
    font-size: clamp(72px, 18vw, 120px);
  }

  .not-found__heading {
    margin: 0;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 800;
    font-size: 20px;
    line-height: 1.25;
  }

  @media screen and (min-width: 750px) {
    .not-found__heading {
      font-size: 26px;
    }
  }

  .not-found__body {
    margin: 0;
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 14px;
    color: var(--text-subtle, #636363);
    max-width: 440px;
    line-height: 1.6;
  }

  .not-found__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .not-found__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 14px;
    padding: 14px 24px;
    text-decoration: none;
    border: 2px solid transparent;
    transition: filter 150ms ease, background 150ms ease;
  }

  .not-found__button--primary {
    background: var(--brand-orange, #c3622c);
    border-color: var(--brand-orange, #c3622c);
    color: var(--brand-black, #000000);
  }

  .not-found__button--outline {
    background: transparent;
    border-color: var(--brand-black, #000000);
    color: var(--brand-black, #000000);
  }

  @media (hover: hover) and (pointer: fine) {
    .not-found__button--primary:hover {
      filter: brightness(0.92);
    }

    .not-found__button--outline:hover {
      background: var(--surface-tertiary, #f7f7f7);
    }
  }

  .not-found__links {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    justify-content: center;
    margin-block-start: 8px;
  }

  @media screen and (min-width: 750px) {
    .not-found__links {
      gap: 24px;
    }
  }

  .not-found__link {
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: var(--text-link, #005ad2);
  }

  /* Decorative bricks — studs are the <i> children. */
  .not-found__bricks {
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: none;
  }

  @media screen and (min-width: 750px) {
    .not-found__bricks {
      display: block;
    }
  }

  .not-found__brick {
    position: absolute;
    display: grid;
    gap: 6px;
    padding: 6px;
    box-sizing: border-box;
  }

  .not-found__brick i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgb(255 255 255 / 40%);
  }

  .not-found__brick--1 {
    top: 14%;
    inset-inline-start: 8%;
    width: 64px;
    height: 40px;
    background: var(--brand-blue, #006cb7);
    transform: rotate(-18deg);
    grid-template-columns: repeat(2, 1fr);
  }

  .not-found__brick--2 {
    top: 62%;
    inset-inline-start: 12%;
    width: 48px;
    height: 48px;
    background: var(--brand-yellow, #ffd400);
    transform: rotate(12deg);
    grid-template-columns: repeat(2, 1fr);
    gap: 4px;
  }

  .not-found__brick--2 i {
    width: 10px;
    height: 10px;
    background: rgb(0 0 0 / 15%);
  }

  .not-found__brick--3 {
    top: 20%;
    inset-inline-end: 10%;
    width: 72px;
    height: 40px;
    background: var(--status-discount-red, #dd0000);
    transform: rotate(24deg);
    grid-template-columns: repeat(3, 1fr);
    gap: 5px;
  }

  .not-found__brick--3 i {
    width: 10px;
    height: 10px;
  }

  .not-found__brick--4 {
    bottom: 16%;
    inset-inline-end: 14%;
    width: 56px;
    height: 56px;
    background: var(--brand-green, #00af4d);
    transform: rotate(-10deg);
    grid-template-columns: repeat(2, 1fr);
    padding: 8px;
  }

  .not-found__brick--4 i {
    background: rgb(255 255 255 / 35%);
  }

  .not-found__brick--5 {
    bottom: 10%;
    inset-inline-start: 20%;
    width: 40px;
    height: 40px;
    background: var(--brand-earth-blue, #00395d);
    transform: rotate(30deg);
    place-items: center;
  }

  .not-found__brick--5 i {
    background: rgb(255 255 255 / 35%);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "404",
  "class": "section--not-found",
  "tag": "section",
  "enabled_on": {
    "templates": ["404"]
  },
  "settings": [
    {
      "type": "text",
      "id": "numeral",
      "label": "Numeral",
      "default": "404"
    },
    {
      "type": "color",
      "id": "numeral_color",
      "label": "Numeral fill",
      "default": "#ffd400"
    },
    {
      "type": "color",
      "id": "numeral_stroke_color",
      "label": "Numeral outline",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Uh-oh — this brick fell out of the set"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "The page you're looking for has gone missing, been retired, or maybe never existed. Let's help you find your way back to building."
    },
    {
      "type": "checkbox",
      "id": "show_decoration",
      "label": "Show scattered bricks",
      "info": "Hidden below 750px so they don't collide with the copy.",
      "default": true
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary label",
      "default": "Back to Homepage"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary label",
      "default": "Search Sets"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Quick link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop by Theme"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "404",
      "blocks": [
        { "type": "link", "settings": { "label": "Shop by Theme" } },
        { "type": "link", "settings": { "label": "Exclusives" } },
        { "type": "link", "settings": { "label": "FAQs" } },
        { "type": "link", "settings": { "label": "Contact Us" } }
      ]
    }
  ]
}
{% endschema %}
