<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">

<div
  class="editorial-grid brickline-section spacing-style section section--{{ section.settings.section_width }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --cols-mobile: {{ section.settings.columns_mobile }}; --cols-tablet: {{ section.settings.columns_tablet }}; --cols-desktop: {{ section.settings.columns }}; --editorial-ratio: {{ section.settings.image_ratio }};"
>
  {% if section.settings.heading != blank %}
    <h2 class="editorial-grid__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="editorial-grid__items brickline-grid">
    {% comment %}
      Tiles come from the product's `custom.story_cards` when this is a product
      template and that list is filled in, so products sharing a template don't
      share its copy. Otherwise the section's own blocks are used, which is what
      every non-product template does.
    {% endcomment %}
    {% liquid
      assign items = section.blocks
      assign from_product = false

      if section.settings.use_product_cards and product != blank
        assign product_cards = product.metafields.custom.story_cards.value
        if product_cards != blank
          assign items = product_cards
          assign from_product = true
        endif
      endif
    %}

    {% for item in items %}
      {% liquid
        if from_product
          # A file_reference resolves to a media_image, but image_picker gives a
          # plain image. Unwrap so image_url / alt / width / height work on either.
          assign card_image = item.image.value
          if card_image.image != blank
            assign card_image = card_image.image
          endif
          assign card_title = item.title.value
          assign card_subtitle = item.subtitle.value
          assign card_button_label = item.button_label.value
          assign card_button_link = item.button_link.value
        else
          assign card_image = item.settings.image
          assign card_title = item.settings.title
          assign card_subtitle = item.settings.subtitle
          assign card_button_label = item.settings.button_label
          assign card_button_link = item.settings.button_link
        endif
      %}
      <article
        class="editorial-grid__item"
        {% unless from_product %}{{ item.shopify_attributes }}{% endunless %}
      >
        <div class="editorial-grid__media">
          {% if card_image != blank %}
            <img
              src="{{ card_image | image_url: width: 900 }}"
              alt="{{ card_image.alt | escape }}"
              class="editorial-grid__image"
              width="{{ card_image.width }}"
              height="{{ card_image.height }}"
              loading="lazy"
            >
          {% endif %}
        </div>

        {% if card_title != blank %}
          <h3 class="editorial-grid__title">{{ card_title }}</h3>
        {% endif %}
        {% if card_subtitle != blank %}
          <p class="editorial-grid__subtitle">{{ card_subtitle }}</p>
        {% endif %}
        {% if card_button_label != blank %}
          <a
            href="{{ card_button_link | default: '#' }}"
            class="editorial-grid__button"
          >
            {{ card_button_label }}
          </a>
        {% endif %}
      </article>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .editorial-grid__heading {
    margin: 0 0 24px;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 24px;
  }

  .editorial-grid__items {
    gap: 32px 20px;
  }

  .editorial-grid__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .editorial-grid__media {
    width: 100%;
    aspect-ratio: var(--editorial-ratio, 16 / 9);
    background: var(--surface-tertiary, #f7f7f7);
    overflow: hidden;
  }

  .editorial-grid__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .editorial-grid__title {
    margin: 0;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 15px;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .editorial-grid__title {
      font-size: 17px;
    }
  }

  .editorial-grid__subtitle {
    margin: 0;
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 13px;
    color: var(--text-subtle, #636363);
    text-align: center;
    line-height: 1.6;
  }

  .editorial-grid__button {
    margin-block-start: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border-default, #d9d9d9);
    background: var(--surface-page, #ffffff);
    color: var(--text-default, #141414);
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 13px;
    padding: 11px 22px;
    text-decoration: none;
    transition: border-color 150ms ease, background 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .editorial-grid__button:hover {
      border-color: var(--brand-black, #000000);
      background: var(--surface-tertiary, #f7f7f7);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial grid",
  "class": "section--editorial-grid",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "use_product_cards",
      "label": "Use the product's story cards",
      "info": "On a product template, fills this grid from the product's Story cards metafield. Falls back to the blocks below when it is empty.",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns — desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns — tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns — mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "16 / 9", "label": "16:9" },
        { "value": "4 / 3", "label": "4:3" },
        { "value": "1 / 1", "label": "Square" }
      ],
      "default": "16 / 9"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Guild Parents Guide"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Read the Parents Guide to keep up with your kids' conversations about who's who and what's going on."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Read more"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial grid",
      "blocks": [{ "type": "story" }, { "type": "story" }]
    }
  ]
}
{% endschema %}
