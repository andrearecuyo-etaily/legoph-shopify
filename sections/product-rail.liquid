{% liquid
  assign tabs = section.blocks | where: 'type', 'tab'
  assign products_to_show = section.settings.products_to_show | default: 8
%}

<link rel="stylesheet" href="{{ 'brickline-cera-pro.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'brickline-tokens.css' | asset_url }}">

<div
  class="product-rail brickline-section spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --brickline-card-radius: {{ settings.brickline_card_radius }}px;"
>
  {% if section.settings.heading != blank %}
    <div class="product-rail__header">
      <h2 class="product-rail__heading">{{ section.settings.heading }}</h2>
    </div>
  {% endif %}

  {% if tabs.size > 0 %}
    <product-rail-component class="product-rail__component">
      <div class="product-rail__tabbar">
        <div
          class="product-rail__tabs"
          role="tablist"
        >
          {% for tab in tabs %}
            <button
              type="button"
              class="product-rail__tab{% if forloop.first %} is-active{% endif %}"
              data-tab-index="{{ forloop.index0 }}"
              role="tab"
              {{ tab.shopify_attributes }}
            >
              {{ tab.settings.label }}
            </button>
          {% endfor %}
        </div>
        <div class="product-rail__arrows">
          <button
            type="button"
            class="product-rail__arrow product-rail__arrow--prev"
            aria-label="{{ 'accessibility.slideshow_previous' | t }}"
          >
            <span class="svg-wrapper">{{- 'icon-chevron-left.svg' | inline_asset_content -}}</span>
          </button>
          <button
            type="button"
            class="product-rail__arrow product-rail__arrow--next"
            aria-label="{{ 'accessibility.slideshow_next' | t }}"
          >
            <span class="svg-wrapper">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span>
          </button>
        </div>
      </div>

      {% for tab in tabs %}
        {% liquid
          assign tab_collection = tab.settings.collection
        %}
        <div
          class="product-rail__panel{% if forloop.first %} is-active{% endif %}"
          data-panel-index="{{ forloop.index0 }}"
          {% unless forloop.first %}hidden{% endunless %}
        >
          {% if tab_collection != blank and tab_collection.products.size > 0 %}
            <div
              class="product-rail__track"
              role="region"
              aria-label="{{ tab.settings.label | escape }}"
            >
              {% for product in tab_collection.products limit: products_to_show %}
                {% render 'product-rail-card', product: product %}
              {% endfor %}
            </div>
            <div class="product-rail__progress">
              <div class="product-rail__progress-bar"></div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </product-rail-component>
  {% endif %}
</div>

<script
  src="{{ 'product-rail.js' | asset_url }}"
  type="module"
></script>
<script
  src="{{ 'lazy-image-fade.js' | asset_url }}"
  type="module"
></script>

{% stylesheet %}
  product-rail-component {
    display: block;
    position: relative;
  }

  .product-rail__header {
    text-align: center;
    margin-block-end: 32px;
  }

  .product-rail__heading {
    margin: 0;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 600;
    font-size: 28px;

    @media screen and (min-width: 750px) {
      font-size: 32px;
    }
  }

  .product-rail__tabbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-block-end: 28px;
    padding-block-end: 12px;
    border-bottom: 1px solid var(--color-border-default, #d9d9d9);
  }

  .product-rail__tabs {
    display: flex;
    gap: 28px;
    overflow-x: auto;
  }

  .product-rail__tab {
    background: none;
    border: none;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: var(--text-meta, #939393);
    cursor: pointer;
    white-space: nowrap;
    padding: 0 0 12px;
    margin-bottom: -13px;
    border-bottom: 2px solid transparent;
    transition: color 150ms ease;
  }

  .product-rail__tab.is-active {
    color: #141414;
    border-bottom-color: #141414;
  }

  .product-rail__arrows {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }

  .product-rail__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--color-border-default, #d9d9d9);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background 150ms ease, border-color 150ms ease;
  }

  .product-rail__arrow--next {
    border: 2px solid #141414;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-rail__tab:not(.is-active):hover {
      color: #141414;
    }

    .product-rail__arrow:hover {
      background: var(--surface-tertiary, #f7f7f7);
      border-color: #141414;
    }
  }

  .product-rail__arrow .svg-wrapper {
    width: 16px;
    height: 16px;
    display: flex;
  }

  .product-rail__panel[hidden] {
    display: none;
  }

  .product-rail__track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 24px;
    padding-block-end: 4px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .product-rail__track::-webkit-scrollbar {
    display: none;
  }

  .product-rail-card {
    scroll-snap-align: start;
    flex: 0 0 74%;
  }

  @media screen and (min-width: 550px) {
    .product-rail-card {
      flex: 0 0 42%;
    }
  }

  @media screen and (min-width: 750px) {
    .product-rail-card {
      flex: 0 0 31%;
    }
  }

  @media screen and (min-width: 990px) {
    .product-rail__track {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 18px;
      overflow-x: visible;
    }

    .product-rail-card {
      flex: unset;
    }
  }

  .product-rail__progress {
    width: 100%;
    height: 3px;
    background: var(--color-border-default, #d9d9d9);
    border-radius: 999px;
    margin-top: 28px;
    overflow: hidden;
  }

  .product-rail__progress-bar {
    width: 20%;
    height: 100%;
    background: var(--text-meta, #939393);
    border-radius: 999px;
    transition: width 200ms ease;
  }

  /* Product tile (snippets/product-rail-card.liquid) */
  .product-rail-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid var(--color-border-default, #d9d9d9);
    border-radius: var(--brickline-card-radius, 0px);
    overflow: hidden;
  }

  .product-rail-card__media-link {
    display: block;
    text-decoration: none;
  }

  .product-rail-card__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    background: #f7f7f7;
  }

  .product-rail-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    background: #f2f2f2;
  }

  .product-rail-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .product-rail-card__image.is-loaded {
    opacity: 1;
  }

  .product-rail-card__badge {
    position: absolute;
    top: 10px;
    right: 10px;
    display: inline-flex;
    align-items: center;
    padding: 4px 8px;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.02em;
    background: #dd0000;
    color: #ffffff;
  }

  .product-rail-card__badge--neutral {
    background: #f2f2f2;
    color: #141414;
  }

  .product-rail-card__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px;
  }

  .product-rail-card__meta {
    display: flex;
    gap: 12px;
    font-size: 12px;
    color: var(--text-meta, #939393);
    align-items: center;
  }

  .product-rail-card__meta-item {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .product-rail-card__meta-item .svg-wrapper {
    width: 13px;
    height: 13px;
    display: flex;
  }

  .product-rail-card__title {
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: #141414;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-rail-card__price {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .product-rail-card__price-compare {
    font-family: "Cera Pro", var(--font-body--family), sans-serif;
    font-size: 13px;
    color: #636363;
    text-decoration: line-through;
  }

  .product-rail-card__price-sale {
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #bd0000;
  }

  .product-rail-card__price-regular {
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #141414;
  }

  .product-rail-card__actions {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-top: 4px;
  }

  add-to-cart-pill {
    display: block;
    flex: 1;
    min-width: 0;
  }

  .product-rail-card__add-button {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: none;
    background: #ffd400;
    color: #000000;
    font-family: "Cera Pro", var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 12px;
    padding: 8px 14px;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 150ms ease, opacity 150ms ease, filter 150ms ease;
  }

  .product-rail-card__add-button:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .product-rail-card__add-button:not(:disabled):hover {
      filter: brightness(0.92);
    }
  }

  .product-rail-card__add-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .product-rail-card__add-button.is-loading {
    opacity: 0.7;
  }

  .product-rail-card__add-label--added {
    display: none;
  }

  add-to-cart-pill.is-added .product-rail-card__add-label:not(.product-rail-card__add-label--added) {
    display: none;
  }

  add-to-cart-pill.is-added .product-rail-card__add-label--added {
    display: inline;
  }

  .product-rail-card__wishlist {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--color-border-default, #d9d9d9);
    background: transparent;
    color: #141414;
    cursor: pointer;
    padding: 0;
    transition: color 150ms ease, background 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-rail-card__wishlist:hover {
      background: var(--surface-tertiary, #f7f7f7);
    }
  }

  .product-rail-card__wishlist[data-active] {
    color: #dd0000;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product rail",
  "class": "section--product-rail",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recommended For You"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products per tab",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 5
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-white"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Featured"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product rail",
      "settings": {
        "heading": "Recommended For You"
      },
      "blocks": [
        { "type": "tab", "settings": { "label": "Featured" } },
        { "type": "tab", "settings": { "label": "Popular" } },
        { "type": "tab", "settings": { "label": "Kids' sets" } }
      ]
    }
  ]
}
{% endschema %}
